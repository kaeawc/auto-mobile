{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "jsPlugins": ["./oxlint-plugins/auto-mobile.mjs"],
  "ignorePatterns": [
    "ios/**",
    "android/**",
    "scratch/**",
    "dist/**",
    "node_modules/**",
    "docs-assets/**",
    "**/*.generated.ts",
    "**/generated/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.jsx"
  ],
  "categories": { "correctness": "off" },
  "rules": {
    "eqeqeq": "error",
    "accessor-pairs": ["error", { "getWithoutSet": false, "setWithoutGet": false }],
    "curly": ["error", "all"],
    "prefer-const": "error",
    "no-var": "error",
    "no-with": "error",
    "no-multi-str": "error",
    "no-caller": "error",
    "no-implied-eval": "error",
    "no-labels": "error",
    "no-self-compare": "error",
    "no-shadow-restricted-names": "error",
    "no-cond-assign": "error",
    "no-debugger": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "error",
    "no-unreachable": "error",
    "no-unsafe-negation": "error",
    "radix": "error",
    "valid-typeof": "error",
    "no-implicit-globals": "error",
    "no-unused-expressions": [
      "error",
      { "allowShortCircuit": true, "allowTernary": true, "allowTaggedTemplates": true }
    ],
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-proto": "error",
    "require-yield": "error",
    "typescript/no-unused-vars": ["error", { "args": "none", "caughtErrors": "none" }],
    "auto-mobile/no-extension-import": "error",
    "auto-mobile/naming-convention": "error",
    "auto-mobile/no-raw-timer": "error",
    "auto-mobile/no-raw-selector-field-read": "error",
    "auto-mobile/no-structured-content-read": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "Math",
            "property": "random",
            "message": "Use an injected Random or IdGenerator. Math.random() makes production behavior non-deterministic and bypasses the project's test seams."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["lodash", "lodash/*"],
                "message": "Prefer the JavaScript/Node standard library or an existing AutoMobile helper. Do not add a direct lodash dependency."
              },
              {
                "group": ["@modelcontextprotocol/sdk", "@modelcontextprotocol/sdk/*"],
                "message": "The v1 MCP SDK is being removed (#4678). Import from the v2 split packages (@modelcontextprotocol/server, /client, /node) instead."
              }
            ]
          }
        ],
        "max-nested-callbacks": ["error", 3],
        "auto-mobile/no-accumulator-foreach": "error",
        "auto-mobile/no-deprecated-selector-facade": "error",
        "auto-mobile/no-inline-error-normalize": "error",
        "auto-mobile/no-raw-promise-race": "error",
        "auto-mobile/no-direct-bun-spawn": "error",
        "auto-mobile/no-caught-error-interpolation": "error",

        // Ratcheted rules with pre-existing baselined violations. oxlint has no
        // count-based bulk-suppressions file (ESLint's eslint-suppressions.json),
        // so these are WARN and gated by scripts/oxlint-baseline.sh (CLAUDE.md).
        // The two type-aware promise rules are burned down and are "error", but
        // they only run under `--type-aware` (tsgolint). The main `oxlint --fix`
        // stays fast and does NOT run them, so the ratchet script (which runs
        // `oxlint --type-aware`) keeps them in RATCHET_CODES at a zero baseline:
        // any diagnostic there is a new violation and fails the gate.
        "complexity": ["error", 12],
        "max-depth": ["error", 3],
        "max-params": ["error", 4],
        "max-lines-per-function": [
          "error",
          { "max": 150, "skipBlankLines": true, "skipComments": true }
        ],
        "max-classes-per-file": ["error", 1],
        "auto-mobile/max-class-lines": ["error", { "max": 1000 }],
        "auto-mobile/catch-convention": "error",
        "typescript/no-floating-promises": "error",
        "typescript/no-misused-promises": "error",
        "auto-mobile/no-raw-env-number-parse": "error"
      }
    },
    {
      "files": [
        "src/features/navigation/ScreenFingerprint.ts",
        "src/features/navigation/ExploreElementExtraction.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "error"
      }
    },
    {
      "files": ["src/**/*.ts", "test/**/*.ts"],
      "rules": {
        "auto-mobile/no-unknown-cast": "error"
      }
    },
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "no-unused-expressions": "off",
        "auto-mobile/no-bare-expect": "error",
        "auto-mobile/no-as-any": "error",
        "typescript/no-floating-promises": "error"
      }
    },
    {
      "files": ["test/stress/**/*.ts"],
      "rules": {
        "auto-mobile/stress-explicit-timeout": "error"
      }
    },
    {
      "files": ["src/utils/raceWithDeadline.ts"],
      "rules": {
        "auto-mobile/no-raw-promise-race": "off"
      }
    },
    {
      "files": ["**/SystemTimer.ts"],
      "rules": {
        "auto-mobile/no-raw-timer": "off"
      }
    }
  ]
}
