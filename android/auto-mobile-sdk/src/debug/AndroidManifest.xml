<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application>
    <receiver
      android:name="dev.jasonpearson.automobile.sdk.notifications.AutoMobileNotificationReceiver"
      android:exported="true"
      android:permission="android.permission.DUMP">
      <intent-filter>
        <action android:name="dev.jasonpearson.automobile.sdk.NOTIFICATION_POST" />
        <action android:name="dev.jasonpearson.automobile.sdk.NOTIFICATION_CHANNEL_QUERY" />
        <action android:name="dev.jasonpearson.automobile.sdk.NOTIFICATION_CHANNEL_DELETE" />
      </intent-filter>
    </receiver>

    <receiver
      android:name="dev.jasonpearson.automobile.sdk.notifications.AutoMobileNotificationActionReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="dev.jasonpearson.automobile.sdk.NOTIFICATION_ACTION" />
      </intent-filter>
    </receiver>

    <provider
      android:name="dev.jasonpearson.automobile.sdk.database.DatabaseInspectorProvider"
      android:authorities="${applicationId}.automobile.database"
      android:exported="true" />

    <provider
      android:name="dev.jasonpearson.automobile.sdk.storage.SharedPreferencesInspectorProvider"
      android:authorities="${applicationId}.automobile.sharedprefs"
      android:exported="true" />
    <provider
      android:name="dev.jasonpearson.automobile.sdk.keystore.KeystoreStateProvider"
      android:authorities="${applicationId}.automobile.keystore"
      android:exported="true" />

    <provider
      android:name="dev.jasonpearson.automobile.sdk.capabilities.SdkCapabilitiesProvider"
      android:authorities="${applicationId}.automobile.capabilities"
      android:exported="true" />

    <!-- Read-only; every entry point enforces DebugInspectorAccess (shell, root, CtrlProxy). -->
    <provider
      android:name="dev.jasonpearson.automobile.sdk.carapp.CarAppTemplatesProvider"
      android:authorities="${applicationId}.automobile.carapptemplates"
      android:exported="true"
      tools:ignore="ExportedContentProvider" />
  </application>
</manifest>
