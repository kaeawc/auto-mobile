{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["src/index.ts", "src/cli/index.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
  "ignore": ["dist/**", "node_modules/**", "android/**", "src/db/migrations/**", "**/*.d.ts"],
  "ignoreDependencies": [
    "oxlint",
    "oxlint-tsgolint",
    "@borewit/text-codec",
    "@emnapi/runtime",
    "@img/colour",
    "@jimp/diff",
    "@jimp/file-ops",
    "@jimp/js-bmp",
    "@jimp/js-gif",
    "@jimp/js-jpeg",
    "@jimp/js-png",
    "@jimp/js-tiff",
    "@jimp/plugin-blit",
    "@jimp/plugin-blur",
    "@jimp/plugin-circle",
    "@jimp/plugin-color",
    "@jimp/plugin-contain",
    "@jimp/plugin-cover",
    "@jimp/plugin-crop",
    "@jimp/plugin-displace",
    "@jimp/plugin-dither",
    "@jimp/plugin-fisheye",
    "@jimp/plugin-flip",
    "@jimp/plugin-hash",
    "@jimp/plugin-mask",
    "@jimp/plugin-print",
    "@jimp/plugin-quantize",
    "@jimp/plugin-resize",
    "@jimp/plugin-rotate",
    "@jimp/plugin-threshold",
    "@jimp/types",
    "@jimp/utils",
    "@tokenizer/inflate",
    "@tokenizer/token",
    "any-base",
    "await-to-js",
    "bmp-ts",
    "debug",
    "detect-libc",
    "exif-parser",
    "file-type",
    "gifwrap",
    "ieee754",
    "image-q",
    "jpeg-js",
    "mime",
    "ms",
    "omggif",
    "pako",
    "parse-bmfont-ascii",
    "parse-bmfont-binary",
    "parse-bmfont-xml",
    "sax",
    "semver",
    "simple-xml-to-json",
    "strtok3",
    "tinycolor2",
    "token-types",
    "tslib",
    "uint8array-extras",
    "utif2",
    "xml-parse-from-string",
    "xmlbuilder"
  ],
  "ignoreBinaries": [],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "typescript": {
    "config": "tsconfig.dead-code.json"
  },
  "ignoreIssues": {
    "test/**/*.typecheck.ts": ["exports", "types"],
    "src/daemon/managedSlots/migrations/**": ["exports"]
  }
}
