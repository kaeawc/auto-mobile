{
  "$comment": "Managed-slot contract published with the package (#12060). test/models/managedSlotContract.test.ts fails when the code drifts from this file; update both together.",
  "contractFileVersion": 1,
  "contractVersions": [1],
  "launchConfig": { "flag": "--managed-slot-config", "env": "AUTOMOBILE_MANAGED_SLOT_CONFIG" },
  "capabilityProbeMethod": "daemon/capabilities",
  "acquireMethod": "daemon/acquireManagedSlots",
  "initializeExperimentalKey": "automobile/managedSlots",
  "daemonCapabilities": {
    "base": "managed-slots/v1",
    "additive": [
      {
        "capability": "managed-slots/v1.deviceFamily",
        "configField": "requests[].requestedSpec.deviceFamily"
      }
    ]
  },
  "maxGroupSize": 1,
  "configErrorCodes": [
    "managed_slot_config_invalid",
    "contract_unsupported",
    "managed_slot_group_unsupported",
    "managed_slots_unsupported"
  ],
  "registry": {
    "migrations": [
      "2026_10_09_000_slot_registry",
      "2026_10_09_001_slot_owner_fencing",
      "2026_10_09_002_slot_journal",
      "2026_10_10_003_free_device_stop_state",
      "2026_10_12_004_free_device_deletion",
      "2026_10_13_005_free_device_deletion_failed_deletes"
    ],
    "olderBuildOnNewerRegistry": {
      "supported": false,
      "refusedBeforeMutation": false,
      "note": "migrateSlotRegistry returns early when every migration this build knows has executed; migrations recorded by a newer build are not detected. Do not run an older daemon against a registry a newer daemon migrated."
    }
  },
  "packageVersions": [
    {
      "range": "<=0.0.84",
      "managedSlots": false,
      "note": "0.0.84 (source b51bfe50dfeb608ed838acf89481b70652084b81) predates managed slots: no --managed-slot-config and no managed-slots capability."
    }
  ],
  "compatibility": [
    {
      "id": "v1-on-current-daemon",
      "description": "A single-slot v1 frontend can acquire on the current daemon.",
      "frontend": { "contractVersion": 1, "groupSize": 1, "usesDeviceFamily": false },
      "daemonCapabilities": ["managed-slots/v1", "managed-slots/v1.deviceFamily"],
      "supported": true,
      "outcome": "acquire",
      "refusedBeforeMutation": false,
      "verifiedBy": "unit-test"
    },
    {
      "id": "v1-on-v1-only-daemon",
      "description": "A base v1 config can acquire on a daemon advertising only the base capability.",
      "frontend": { "contractVersion": 1, "groupSize": 1, "usesDeviceFamily": false },
      "daemonCapabilities": ["managed-slots/v1"],
      "supported": true,
      "outcome": "acquire",
      "refusedBeforeMutation": false,
      "verifiedBy": "unit-test"
    },
    {
      "id": "device-family-on-v1-only-daemon",
      "description": "A deviceFamily config is refused by a daemon lacking its additive capability.",
      "frontend": { "contractVersion": 1, "groupSize": 1, "usesDeviceFamily": true },
      "daemonCapabilities": ["managed-slots/v1"],
      "supported": false,
      "outcome": "contract_unsupported",
      "refusedBeforeMutation": true,
      "verifiedBy": "unit-test"
    },
    {
      "id": "device-family-on-current-daemon",
      "description": "A deviceFamily config can acquire when the daemon advertises its additive capability.",
      "frontend": { "contractVersion": 1, "groupSize": 1, "usesDeviceFamily": true },
      "daemonCapabilities": ["managed-slots/v1", "managed-slots/v1.deviceFamily"],
      "supported": true,
      "outcome": "acquire",
      "refusedBeforeMutation": false,
      "verifiedBy": "unit-test"
    },
    {
      "id": "any-on-daemon-without-managed-slots",
      "description": "A managed frontend is refused by a daemon without managed-slot support, including 0.0.84.",
      "frontend": { "contractVersion": 1, "groupSize": 1, "usesDeviceFamily": false },
      "daemonCapabilities": [],
      "supported": false,
      "outcome": "contract_unsupported",
      "refusedBeforeMutation": true,
      "verifiedBy": "unit-test"
    },
    {
      "id": "contract-version-2",
      "description": "Contract version 2 is refused during config parsing.",
      "frontend": { "contractVersion": 2, "groupSize": 1, "usesDeviceFamily": false },
      "daemonCapabilities": ["managed-slots/v1", "managed-slots/v1.deviceFamily"],
      "supported": false,
      "outcome": "contract_unsupported",
      "refusedBeforeMutation": true,
      "verifiedBy": "unit-test"
    },
    {
      "id": "multi-device-group",
      "description": "Groups of two devices are refused during config parsing.",
      "frontend": { "contractVersion": 1, "groupSize": 2, "usesDeviceFamily": false },
      "daemonCapabilities": ["managed-slots/v1", "managed-slots/v1.deviceFamily"],
      "supported": false,
      "outcome": "managed_slot_group_unsupported",
      "refusedBeforeMutation": true,
      "verifiedBy": "unit-test"
    },
    {
      "id": "unmanaged-frontend-shares-daemon",
      "description": "An ordinary frontend can share a managed-slot daemon; native qualification is still owed.",
      "frontend": null,
      "daemonCapabilities": ["managed-slots/v1", "managed-slots/v1.deviceFamily"],
      "supported": true,
      "outcome": "unmanaged",
      "refusedBeforeMutation": false,
      "verifiedBy": "native-qualification"
    }
  ]
}
