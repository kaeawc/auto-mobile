{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "caseId": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "matrixItem": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        {
          "type": "null"
        }
      ]
    },
    "platform": {
      "type": "string",
      "enum": ["android", "ios", "host"]
    },
    "proofLevel": {
      "type": "string",
      "enum": ["source-tests", "local-build", "published-package"]
    },
    "artifact": {
      "description": "local-build and published-package require non-null packageVersion and sourceSha; published-package also requires non-null integrity.",
      "type": "object",
      "properties": {
        "packageVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceSha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrity": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha512-"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["packageVersion", "sourceSha", "integrity"],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "argv": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?!.*\\\\)(?!.*~)(?!.*(?:^|\\/)\\.\\.(?:\\/|$)).+$"
        }
      },
      "required": ["argv", "cwd"],
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": ["pass", "fail", "blocked", "not-exercised"]
    },
    "observation": {
      "description": "Native observation is invalid at the source-tests proof level.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "native"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "injected-fault"
            },
            "mechanism": {
              "type": "string",
              "minLength": 1
            },
            "fault": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "mechanism", "fault"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "deterministic-test"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "timings": {
      "type": "object",
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
        },
        "finishedAt": {
          "description": "finishedAt must be at or after startedAt.",
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-]\\d{2}:\\d{2})))$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operations": {
          "description": "Operation durationMs may exceed budgetMs; the aggregator flags this evidence.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "budgetMs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["name", "durationMs", "budgetMs"],
            "additionalProperties": false
          }
        }
      },
      "required": ["startedAt", "finishedAt", "durationMs", "operations"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?!.*\\\\)(?!.*~)(?!.*(?:^|\\/)\\.\\.(?:\\/|$)).+$"
          },
          "kind": {
            "type": "string",
            "enum": ["log", "json", "screenshot", "video", "db-snapshot", "other"]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["path", "kind", "sha256"],
        "additionalProperties": false
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^fixture-[a-z0-9-]{1,48}$"
          }
        },
        "required": ["role", "id"],
        "additionalProperties": false
      }
    },
    "failureCode": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "boundary": {
      "description": "boundary must be non-empty for blocked or not-exercised outcomes.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "title",
    "matrixItem",
    "platform",
    "proofLevel",
    "artifact",
    "command",
    "outcome",
    "observation",
    "timings",
    "evidence",
    "fixtures",
    "failureCode",
    "boundary",
    "notes"
  ],
  "additionalProperties": false
}
