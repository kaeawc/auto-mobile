#!/usr/bin/env bats
setup() {
  ROOT="$(cd "$BATS_TEST_DIRNAME/../.." && pwd)"
  SCRIPT="$ROOT/scripts/android/compose-compiler-report.sh"
  FIXTURE="$ROOT/test/bats/fixtures/compose-compiler-report"
  export CALLS="$BATS_TEST_TMPDIR/calls"
  export COMPOSE_REPORT_GRADLEW="$BATS_TEST_TMPDIR/gradlew"
  cat > "$COMPOSE_REPORT_GRADLEW" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$CALLS"
pwd > "$CALLS.cwd"
exit 0
STUB
  chmod +x "$COMPOSE_REPORT_GRADLEW"
}
@test "default compile uses exactly the task rerun and opt-in property" {
  isolated="$BATS_TEST_TMPDIR/repo"
  mkdir -p "$isolated/scripts/android" "$isolated/android/prototype-compose/build/compose-compiler-reports"
  cp "$SCRIPT" "$isolated/scripts/android/"
  cp -R "$FIXTURE/." "$isolated/android/prototype-compose/build/compose-compiler-reports/"
  run "$isolated/scripts/android/compose-compiler-report.sh"
  [ "$status" -eq 0 ]
  [ "$(cat "$CALLS.cwd")" = "$isolated/android" ]
  [ "$(cat "$CALLS")" = $':prototype-compose:compileReleaseKotlin\n--rerun\n-Pautomobile.composeCompilerReports=true' ]
}
@test "captured functions have stability columns and package filter" {
  run "$SCRIPT" --reports-dir "$FIXTURE"
  [ "$status" -eq 0 ]
  [ ! -e "$CALLS" ]
  [[ "$output" != *KeyCap* && "$output" != *KeyRow* ]]
  [[ "$output" == *'| RenderPrototypeNode | yes | yes | — | — |'* ]]
  [[ "$output" == *'`theme: PrototypeThemeSpec`; `explicit: PrototypeSpecTheme?`'* ]]
  [[ "$output" == *'| PrototypeAnchorLayer | yes | yes | — | `anchors: List<LayeredPrototypeAnchor>` |'* ]]
  [[ "$output" == *'| prototypeThemedColor | no | no | `spec: PrototypeModeValue?` | — |'* ]]
  [[ "$output" == *'| NavigationPlaceholder | yes | yes | — | — |'* ]]
  [[ "$output" != *' = @static'* ]]
  [[ "$output" == *'StrongSkipping=true.'* ]]
  [ "$(printf '%s\n' "$output" | grep -c '^| PrototypeTheme |')" -eq 2 ]
  run "$SCRIPT" --reports-dir "$FIXTURE" --package dev.jasonpearson.automobile.ctrlproxy.ime.keyboard.ui
  [ "$status" -eq 0 ]
  [[ "$output" == *KeyCap* && "$output" != *RenderPrototypeNode* ]]
}
@test "write-doc creates a generated page and is byte-idempotent without leftover temp files" {
  directory="$BATS_TEST_TMPDIR/generated"
  mkdir "$directory"
  doc="$directory/report.md"
  run "$SCRIPT" --reports-dir "$FIXTURE" --write-doc "$doc"
  [ "$status" -eq 0 ]
  [ "$(head -1 "$doc")" = '# Prototype Compose compiler report' ]
  [ "$(sed -n '2p' "$doc")" = 'Generated by scripts/android/compose-compiler-report.sh --write-doc; do not edit by hand.' ]
  [ -z "$(sed -n '3p' "$doc")" ]
  [ "$(tail -n +4 "$doc")" = "$output" ]
  cp "$doc" "$BATS_TEST_TMPDIR/doc.copy"
  run "$SCRIPT" --reports-dir "$FIXTURE" --write-doc "$doc"
  [ "$status" -eq 0 ]
  cmp "$doc" "$BATS_TEST_TMPDIR/doc.copy"
  [ "$(ls -A "$directory")" = report.md ]
}
@test "write-doc overwrites unrelated content" {
  doc="$BATS_TEST_TMPDIR/doc.md"
  printf 'unrelated content\n' > "$doc"
  run "$SCRIPT" --reports-dir "$FIXTURE" --write-doc "$doc"
  [ "$status" -eq 0 ]
  [ "$(head -1 "$doc")" = '# Prototype Compose compiler report' ]
  ! grep -q 'unrelated content' "$doc"
  [ "$(tail -n +4 "$doc")" = "$output" ]
}
@test "write-doc rejects a missing parent directory" {
  run "$SCRIPT" --reports-dir "$FIXTURE" --write-doc "$BATS_TEST_TMPDIR/missing/doc.md"
  [ "$status" -eq 2 ]
  [[ "$output" == *'directory not found'* ]]
  [ ! -e "$BATS_TEST_TMPDIR/missing" ]
}
@test "missing reports and unknown options exit two" {
  run "$SCRIPT" --reports-dir "$BATS_TEST_TMPDIR"
  [ "$status" -eq 2 ]; [[ "$output" == *'missing report'* ]]
  mkdir "$BATS_TEST_TMPDIR/release"
  cp "$FIXTURE/prototype-compose-composables.txt" "$BATS_TEST_TMPDIR/"
  run "$SCRIPT" --reports-dir "$BATS_TEST_TMPDIR"
  [ "$status" -eq 2 ]; [[ "$output" == *'release/prototype-compose-module.json'* ]]
  run "$SCRIPT" --bogus
  [ "$status" -eq 2 ]; [[ "$output" == *'unknown option'* ]]
}

@test "parameter pipes are escaped and overload order is deterministic" {
  copied="$BATS_TEST_TMPDIR/reports"
  mkdir -p "$copied"
  cp -R "$FIXTURE/." "$copied/"
  # Derive a parser edge case from the captured block, leaving the fixture byte-exact.
  sed 's/unstable theme: PrototypeThemeSpec/unstable theme: PrototypeThemeSpec | Other/' "$FIXTURE/prototype-compose-composables.txt" > "$copied/prototype-compose-composables.txt"
  run "$SCRIPT" --reports-dir "$copied"
  [ "$status" -eq 0 ]
  [[ "$output" == *'`theme: PrototypeThemeSpec \| Other`'* ]]
  first="$output"
  run "$SCRIPT" --reports-dir "$copied"
  [ "$status" -eq 0 ]; [ "$output" = "$first" ]
  [ "$(printf '%s\n' "$output" | grep '^| PrototypeTheme |' | head -1)" = '| PrototypeTheme | yes | yes | `explicit: PrototypeSpecTheme?` | — |' ]
}
