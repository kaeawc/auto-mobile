exports[`native host file templates Compose host file 1`] = `
"package prototypes

import androidx.compose.runtime.Composable
import androidx.compose.runtime.remember
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalContext
import dev.jasonpearson.automobile.protocol.PrototypeEvent
import dev.jasonpearson.automobile.prototype.AutoMobilePrototype
import dev.jasonpearson.automobile.prototype.PrototypeAssets
import dev.jasonpearson.automobile.prototype.PrototypeDismissReason
import dev.jasonpearson.automobile.prototype.PrototypeNetwork
import dev.jasonpearson.automobile.prototype.PrototypeStorage

/**
 * The checkout prototype, drawn by the AutoMobile prototype renderer. Generated by
 * automobile:prototype/native: the spec and assets live under assets/prototypes/checkout.
 */
@Composable
fun CheckoutPrototype(
  modifier: Modifier = Modifier,
  network: PrototypeNetwork = remember { PrototypeNetwork() },
  onEvent: (PrototypeEvent) -> Unit = {},
  onDismiss: (PrototypeDismissReason) -> Unit = {},
) {
  val context = LocalContext.current
  val read = { path: String -> context.assets.open(path).use { it.readBytes() } }
  val spec = remember(context) { read("prototypes/checkout/spec.json").decodeToString() }
  val assets = remember(context) {
    PrototypeAssets(
      images = mapOf("hero" to read("prototypes/checkout/hero.png")),
      fonts = mapOf("brand" to read("prototypes/checkout/brand.ttf")),
    )
  }
  AutoMobilePrototype(
    spec = spec,
    modifier = modifier,
    assets = assets,
    storage = remember(context) { PrototypeStorage.fileBacked(context) },
    network = network,
    onEvent = onEvent,
    onDismiss = onDismiss,
  )
}
"
`;

exports[`native host file templates SwiftUI host file 1`] = `
"import AutoMobilePrototype
import Foundation
import SwiftUI

/// The checkout prototype, drawn by the AutoMobile prototype renderer. Generated by
/// automobile:prototype/native: the spec and assets live in Prototypes/checkout.
struct CheckoutPrototype: View {
    var network: PrototypeNetworkConfiguration = .default
    var onEvent: @MainActor (PrototypeEvent) -> Void = { _ in }
    var onDismiss: @MainActor (PrototypeDismissReason) -> Void = { _ in }

    var body: some View {
        AutoMobilePrototypeView(
            spec: Self.resource("spec.json"),
            assets: PrototypeAssets(images: ["hero": Self.resource("hero.png")], fonts: ["brand": Self.resource("brand.ttf")]),
            storage: .fileBacked,
            network: network,
            onEvent: onEvent,
            onDismiss: onDismiss
        )
    }

    /// Bundled file bytes; a missing spec shows the renderer's load-error view instead of a blank screen.
    private static func resource(_ name: String) -> Data {
        let url = Bundle.main.bundleURL
            .appendingPathComponent("Prototypes/checkout")
            .appendingPathComponent(name)
        return (try? Data(contentsOf: url)) ?? Data()
    }
}
"
`;
