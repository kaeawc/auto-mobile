exports[`readPrototypeSourceResource(compose) the output file 1`] = `
"// Generated by automobile:prototype/checkout/compose (revision 1, frame pixel-9).
// Library (Gradle): implementation("dev.jasonpearson.auto-mobile:auto-mobile-prototype-compose:1.2.3")
// Required capabilities: none
// Assets (not inlined; add each file at its path, a saved prototype serves its bytes):
//   image app/src/main/assets/prototypes/checkout/hero <- automobile:prototype/native/asset?id=checkout&assetId=hero
//   font app/src/main/assets/prototypes/checkout/brand <- automobile:prototype/native/asset?id=checkout&assetId=brand

package prototypes

import android.content.Context
import androidx.compose.runtime.Composable
import androidx.compose.runtime.remember
import androidx.compose.ui.Modifier
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.tooling.preview.Preview
import dev.jasonpearson.automobile.protocol.PrototypeEvent
import dev.jasonpearson.automobile.prototype.AutoMobilePrototype
import dev.jasonpearson.automobile.prototype.PrototypeAssets
import dev.jasonpearson.automobile.prototype.PrototypeDismissReason
import dev.jasonpearson.automobile.prototype.PrototypeNetwork
import dev.jasonpearson.automobile.prototype.PrototypeStorage

/** The app assets directory holding this prototype's spec.json and asset files. */
private const val DIRECTORY = "prototypes/checkout"

/** The prototype spec JSON, compiled in. */
private const val SPEC = "{\\"id\\":\\"checkout\\",\\"window\\":{\\"placement\\":{\\"type\\":\\"fullscreen\\"}},\\"root\\":{\\"type\\":\\"column\\",\\"style\\":{\\"fontFamily\\":{\\"asset\\":\\"brand\\"}},\\"children\\":[{\\"type\\":\\"image\\",\\"asset\\":\\"hero\\"},{\\"type\\":\\"text\\",\\"text\\":\\"Pay \\$5 \\\\\\"now\\\\\\" \\\\\\\\ \\u00e9 \\ud83d\\ude42\\"}]}}"

/**
 * The checkout prototype, drawn by the AutoMobile prototype renderer. Generated by
 * automobile:prototype/checkout/compose: the spec is inlined above and the assets live under
 * assets/prototypes/checkout.
 */
@Composable
fun CheckoutPrototype(
  modifier: Modifier = Modifier,
  network: PrototypeNetwork = remember { PrototypeNetwork() },
  onEvent: (PrototypeEvent) -> Unit = {},
  onDismiss: (PrototypeDismissReason) -> Unit = {},
) {
  val context = LocalContext.current
  val read = { path: String -> context.readAsset(path) }
  val spec = SPEC
  val assets =
    remember(context) {
      PrototypeAssets(
        images =
          listOfNotNull(
              read("$DIRECTORY/hero")?.let { "hero" to it },
            )
            .toMap(),
        fonts =
          listOfNotNull(
              read("$DIRECTORY/brand")?.let { "brand" to it },
            )
            .toMap(),
      )
    }
  AutoMobilePrototype(
    spec = spec,
    modifier = modifier,
    assets = assets,
    storage = PrototypeStorage.None,
    network = network,
    onEvent = onEvent,
    onDismiss = onDismiss,
  )
}

/** A bundled file's bytes, or null when the app does not ship it. */
private fun Context.readAsset(path: String): ByteArray? = runCatching {
  assets.open(path).use { it.readBytes() }
}
  .getOrNull()

@Preview(name = "Pixel 9", widthDp = 411, heightDp = 923)
@Composable
private fun CheckoutPrototypePreview() {
  CheckoutPrototype()
}
"
`;

exports[`readPrototypeSourceResource(swiftui) the output file 1`] = `
"// Generated by automobile:prototype/checkout/swiftui (revision 1, frame iphone-16).
// Library (SwiftPM): .package(url: "https://github.com/kaeawc/auto-mobile", from: "1.2.3"), product "AutoMobilePrototype"
// Required capabilities: none
// Assets (not inlined; add each file at its path, a saved prototype serves its bytes):
//   image Prototypes/checkout/hero <- automobile:prototype/native/asset?id=checkout&assetId=hero
//   font Prototypes/checkout/brand <- automobile:prototype/native/asset?id=checkout&assetId=brand

import AutoMobilePrototype
import Foundation
import SwiftUI

/// The checkout prototype, drawn by the AutoMobile prototype renderer. Generated by
/// automobile:prototype/checkout/swiftui: the spec is inlined below and the assets live in
/// Prototypes/checkout.
struct CheckoutPrototype: View {
    var network: PrototypeNetworkConfiguration = .default
    var onEvent: @MainActor (PrototypeEvent) -> Void = { _ in }
    var onDismiss: @MainActor (PrototypeDismissReason) -> Void = { _ in }

    // Read once per process, not on every body evaluation.
    private static let spec = Data("{\\"id\\":\\"checkout\\",\\"window\\":{\\"placement\\":{\\"type\\":\\"fullscreen\\"}},\\"root\\":{\\"type\\":\\"column\\",\\"style\\":{\\"fontFamily\\":{\\"asset\\":\\"brand\\"}},\\"children\\":[{\\"type\\":\\"image\\",\\"asset\\":\\"hero\\"},{\\"type\\":\\"text\\",\\"text\\":\\"Pay $5 \\\\\\"now\\\\\\" \\\\\\\\ \\u{e9} \\u{1f642}\\"}]}}".utf8)
    private static let assets = PrototypeAssets(images: ["hero": resource("hero")], fonts: ["brand": resource("brand")])

    var body: some View {
        AutoMobilePrototypeView(
            spec: Self.spec,
            assets: Self.assets,
            storage: .none,
            network: network,
            onEvent: onEvent,
            onDismiss: onDismiss
        )
    }

    /// Bundled file bytes; a missing spec shows the renderer's load-error view instead of a blank screen.
    private static func resource(_ name: String) -> Data {
        let url = Bundle.main.bundleURL
            .appendingPathComponent("Prototypes/checkout")
            .appendingPathComponent(name)
        return (try? Data(contentsOf: url)) ?? Data()
    }
}

#Preview("iPhone 16") {
    CheckoutPrototype()
        .frame(width: 393, height: 852)
}
"
`;
