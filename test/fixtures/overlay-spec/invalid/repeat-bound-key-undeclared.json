{
  "spec": {
    "id": "prototype",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "liked_a": false
    },
    "root": {
      "type": "column",
      "repeat": {
        "items": [
          {
            "id": "a"
          },
          {
            "id": "b"
          }
        ],
        "as": "item"
      },
      "children": [
        {
          "type": "text",
          "text": "Like",
          "onTap": [
            {
              "type": "toggle",
              "key": "liked_{item.id}"
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.children[0].onTap[0].key"
}
