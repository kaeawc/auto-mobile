      "source": "README.md, PR #15787",
      "derivedFrom": "xctrace 27.1 (Xcode 27.1 beta, 27A9269) export on a booted iPhone 18 Pro iOS 27.0 simulator",
      "edits": "truncated to the first 200 rows with all refs resolving; home path scrubbed to /Users/user/",
    },
    "xctrace-toc-empty-unfinalized-hitches-ios27.xml": {
