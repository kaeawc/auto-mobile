{
  "description": "Shared criticalSection lock and barrier params cases, generated from the daemon PlanValidator by a scratch generator. Consumed by test/utils/plan/PlanValidatorCoordinationParams.test.ts (PlanValidator) and the Kotlin CoordinationParamsParityTest (TestPlanValidator). Both must reach expected.valid; when invalid, the Kotlin messages (one per error) must contain expected.message split on newlines as a contiguous run, in order (Kotlin also reports schema errors and later checks that the daemon never reaches because it throws at the first failing check).",
  "cases": [
    {
      "name": "accepts a criticalSection lock entered once by each of deviceCount devices",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "L",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          },
          {
            "tool": "criticalSection",
            "params": {
              "device": "B",
              "lock": "L",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "B"
                  }
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "valid": true
      }
    },
    {
      "name": "rejects criticalSection steps that disagree on deviceCount",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "L",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          },
          {
            "tool": "criticalSection",
            "params": {
              "device": "B",
              "lock": "L",
              "deviceCount": 3,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "B"
                  }
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "criticalSection lock \"L\" has inconsistent deviceCount values: step 0 deviceCount=2, step 1 deviceCount=3. All steps sharing a lock must declare the same deviceCount."
      }
    },
    {
      "name": "rejects a criticalSection lock with fewer steps than deviceCount",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "L",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "criticalSection lock \"L\" declares deviceCount=2 but 1 step references it. Every participating device needs its own criticalSection step with this lock."
      }
    },
    {
      "name": "rejects a criticalSection lock with more steps than deviceCount",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "L",
              "deviceCount": 1,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          },
          {
            "tool": "criticalSection",
            "params": {
              "device": "B",
              "lock": "L",
              "deviceCount": 1,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "B"
                  }
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "criticalSection lock \"L\" declares deviceCount=1 but 2 steps reference it. Every participating device needs its own criticalSection step with this lock."
      }
    },
    {
      "name": "rejects a criticalSection lock entered twice by the same device",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "L",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          },
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "L",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "criticalSection lock \"L\" is entered twice by device \"A\" (steps 0, 1). Each device can participate in a given lock at most once."
      }
    },
    {
      "name": "reports criticalSection lock errors in lock order",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "P",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          },
          {
            "tool": "criticalSection",
            "params": {
              "device": "B",
              "lock": "Q",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "B"
                  }
                }
              ]
            }
          },
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "Q",
              "deviceCount": 1,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "criticalSection lock \"P\" declares deviceCount=2 but 1 step references it. Every participating device needs its own criticalSection step with this lock.\ncriticalSection lock \"Q\" has inconsistent deviceCount values: step 1 deviceCount=2, step 2 deviceCount=1. All steps sharing a lock must declare the same deviceCount."
      }
    },
    {
      "name": "an inconsistent criticalSection deviceCount is reported instead of a deadlock",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "criticalSection",
            "params": {
              "device": "A",
              "lock": "L",
              "deviceCount": 2,
              "steps": [
                {
                  "tool": "pressButton",
