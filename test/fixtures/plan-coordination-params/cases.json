                    "button": "home",
                    "device": "A"
                  }
                }
              ]
            }
          },
          {
            "tool": "criticalSection",
            "params": {
              "device": "B",
              "lock": "L",
              "deviceCount": 3,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "B"
                  }
                }
              ]
            }
          },
          {
            "tool": "criticalSection",
            "params": {
              "device": "B",
              "lock": "M",
              "deviceCount": 1,
              "steps": [
                {
                  "tool": "pressButton",
                  "params": {
                    "button": "home",
                    "device": "B"
                  }
                }
              ]
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "criticalSection lock \"L\" has inconsistent deviceCount values: step 0 deviceCount=2, step 1 deviceCount=3. All steps sharing a lock must declare the same deviceCount."
      }
    },
    {
      "name": "rejects a barrier step without a lock",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "barrier",
            "params": {
              "device": "A",
              "deviceCount": 2
            }
          },
          {
            "tool": "barrier",
            "params": {
              "device": "B",
              "lock": "X",
              "deviceCount": 2
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "barrier step 0 is missing a non-empty 'lock' parameter."
      }
    },
    {
      "name": "rejects a barrier step with an empty lock",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "barrier",
            "params": {
              "device": "A",
              "lock": "",
              "deviceCount": 2
            }
          },
          {
            "tool": "barrier",
            "params": {
              "device": "B",
              "lock": "",
              "deviceCount": 2
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "barrier step 0 is missing a non-empty 'lock' parameter.\nbarrier step 1 is missing a non-empty 'lock' parameter."
      }
    },
    {
      "name": "rejects a barrier step without a deviceCount",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "barrier",
