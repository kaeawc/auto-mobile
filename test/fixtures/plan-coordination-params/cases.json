      }
    },
    {
      "name": "rejects a barrier step with a zero deviceCount",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "barrier",
            "params": {
              "device": "A",
              "lock": "X",
              "deviceCount": 0
            }
          },
          {
            "tool": "barrier",
            "params": {
              "device": "B",
              "lock": "X",
              "deviceCount": 0
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "barrier step 0 must declare a positive integer 'deviceCount', got 0.\nbarrier step 1 must declare a positive integer 'deviceCount', got 0."
      }
    },
    {
      "name": "rejects a barrier step with a negative deviceCount",
      "plan": {
        "name": "Coordination",
        "devices": ["A", "B"],
        "steps": [
          {
