  "cases": [
    {
      "name": "rejects an AB-BA cross-lock cycle between two barrier locks",
      "plan": {
        "name": "Feasibility",
        "devices": ["A", "B"],
        "steps": [
          {
            "tool": "barrier",
            "params": {
              "device": "A",
              "lock": "X",
              "deviceCount": 2
            }
          },
          {
            "tool": "barrier",
            "params": {
              "device": "A",
              "lock": "Y",
              "deviceCount": 2
            }
          },
          {
            "tool": "barrier",
            "params": {
              "device": "B",
              "lock": "Y",
              "deviceCount": 2
            }
          },
          {
            "tool": "barrier",
            "params": {
              "device": "B",
              "lock": "X",
              "deviceCount": 2
            }
          }
        ]
      },
      "expected": {
        "valid": false,
        "message": "barrier/criticalSection coordination can never complete: under every possible arrival order at least one device track deadlocks. One reachable stall: device \"A\" waits at barrier lock \"X\" (step 0; 1/2 arrived: A); device \"B\" waits at barrier lock \"Y\" (step 2; 1/2 arrived: B). Locks involved: \"X\", \"Y\". Generations released before the stall: none. Each device's track runs sequentially, so a device blocked at one lock never reaches the later lock its peers are waiting at. Reorder the coordination steps so devices visit shared locks in a consistent order, or add the arrivals the stalled locks are missing."
      }
    },
