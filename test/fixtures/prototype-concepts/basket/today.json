                      },
                      "children": [
                        {
                          "type": "column",
                          "style": {
                            "weight": 1
                          },
                          "children": [
                            {
                              "type": "text",
                              "text": "{item.title}",
                              "style": {
                                "textStyle": "titleSmall"
                              }
                            },
                            {
                              "type": "text",
                              "text": "{item.priceText} each",
                              "style": {
                                "textStyle": "bodySmall"
                              }
                            }
                          ]
                        },
                        {
                          "type": "iconButton",
                          "testTag": "qty_minus",
                          "icon": "remove",
                          "variant": "outlined",
                          "contentDescription": "One fewer",
                          "onTap": [
                            {
                              "type": "decrement",
                              "key": "qty_{item.id}"
                            },
                            {
                              "type": "decrement",
                              "key": "cartCount"
                            }
                          ]
                        },
                        {
                          "type": "text",
                          "testTag": "qty_value",
                          "text": "{qty_{item.id}}",
                          "style": {
                            "textStyle": "titleMedium"
                          }
                        },
                        {
                          "type": "iconButton",
                          "testTag": "qty_plus",
                          "icon": "add",
                          "variant": "outlined",
                          "contentDescription": "One more",
                          "enabledWhen": {
                            "key": "qty_{item.id}",
                            "lt": 9
                          },
                          "onTap": [
                            {
                              "type": "increment",
                              "key": "qty_{item.id}"
                            },
                            {
                              "type": "increment",
                              "key": "cartCount"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "divider"
                },
                {
                  "type": "text",
                  "testTag": "cart_count",
                  "text": "{cartCount} items",
                  "style": {
                    "textStyle": "titleMedium"
                  }
                },
                {
                  "type": "button",
                  "testTag": "checkout_button",
                  "label": "Check out",
                  "onTap": [
                    {
                      "type": "push",
                      "stack": "nav",
                      "screen": "checkout"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "checkout": {
        "type": "column",
        "children": [
          {
            "type": "topAppBar",
            "testTag": "checkout_bar",
            "title": "Checkout",
            "navigationIcon": {
              "icon": "arrow_back",
              "label": "Back",
              "onTap": [
                {
                  "type": "pop",
                  "stack": "nav"
                }
              ]
            }
          },
          {
            "type": "scroll",
            "style": {
              "weight": 1
            },
            "child": {
              "type": "column",
              "style": {
                "padding": {
                  "start": 16,
                  "end": 16,
                  "top": 16,
                  "bottom": 16
                },
                "spacing": 12
              },
              "children": [
                {
                  "type": "textField",
                  "testTag": "name_field",
                  "stateKey": "name",
                  "label": "Full name",
                  "variant": "outlined",
                  "checks": [
                    {
                      "message": "Enter your name",
                      "required": true
                    }
                  ]
                },
                {
                  "type": "textField",
                  "testTag": "street_field",
                  "stateKey": "street",
                  "label": "Street address",
                  "variant": "outlined",
                  "checks": [
                    {
                      "message": "Enter your street address",
                      "required": true
                    },
                    {
                      "message": "Enter at least 5 characters",
                      "minLength": 5
                    }
                  ]
                },
                {
                  "type": "textField",
                  "testTag": "postcode_field",
                  "stateKey": "postcode",
                  "label": "ZIP code",
                  "variant": "outlined",
                  "checks": [
                    {
                      "message": "Enter your ZIP code",
                      "required": true
                    },
                    {
                      "message": "Use 5 digits",
                      "pattern": "\\d{5}"
                    }
                  ],
                  "keyboardType": "number"
                },
                {
                  "type": "text",
                  "text": "Delivery day",
                  "semantics": {
                    "heading": true
                  },
                  "style": {
                    "textStyle": "titleSmall"
                  }
                },
                {
                  "type": "datePicker",
                  "testTag": "delivery_date",
                  "stateKey": "deliveryDate",
                  "checks": [
                    {
                      "message": "Pick a day",
                      "required": true
                    }
                  ]
                },
                {
                  "type": "radioGroup",
                  "testTag": "delivery_slot",
                  "stateKey": "slot",
                  "options": [
                    {
                      "value": "morning",
                      "label": "8 am to noon"
                    },
                    {
                      "value": "afternoon",
                      "label": "Noon to 5 pm"
                    },
                    {
                      "value": "evening",
                      "label": "5 pm to 9 pm"
                    }
                  ]
                },
                {
                  "type": "button",
                  "testTag": "pay_button",
                  "label": "Pay",
                  "icon": "lock",
                  "onTap": [
                    {
                      "type": "emit",
                      "name": "order_placed",
                      "requireValid": ["name", "street", "postcode", "deliveryDate"],
                      "context": {
                        "items": {
                          "state": "cartCount"
                        },
                        "slot": {
                          "state": "slot"
                        }
                      }
                    },
                    {
                      "type": "setState",
                      "key": "orderStep",
                      "value": 0
                    },
                    {
                      "type": "startTimer",
                      "id": "tracking",
                      "afterMs": 2000,
                      "everyMs": 2000,
                      "maxRuns": 3,
                      "actions": [
                        {
                          "type": "increment",
                          "key": "orderStep"
                        }
                      ]
                    },
                    {
                      "type": "replace",
                      "stack": "nav",
                      "screen": "order"
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "order": {
        "type": "column",
        "children": [
          {
            "type": "topAppBar",
            "testTag": "order_bar",
            "title": "Order #1042",
            "navigationIcon": {
              "icon": "close",
              "label": "Close",
              "onTap": [
                {
                  "type": "popToRoot",
                  "stack": "nav"
                }
              ]
            }
          },
          {
            "type": "column",
            "testTag": "order_timeline",
            "style": {
              "padding": {
                "start": 16,
                "end": 16,
                "top": 16,
                "bottom": 16
              },
              "spacing": 12
            },
            "children": [
              {
                "type": "row",
                "testTag": "order_step_0",
                "style": {
                  "spacing": 12,
                  "alignment": "center",
                  "alpha": 0.4
                },
                "styleWhen": [
                  {
                    "when": {
                      "key": "orderStep",
                      "gt": -1
                    },
                    "style": {
                      "alpha": 1
                    }
                  }
                ],
                "children": [
                  {
                    "type": "icon",
                    "name": "check_circle",
                    "contentDescription": "Order placed"
                  },
                  {
                    "type": "text",
                    "text": "Order placed",
                    "style": {
                      "textStyle": "bodyLarge"
                    }
                  }
                ]
              },
              {
                "type": "row",
                "testTag": "order_step_1",
                "style": {
                  "spacing": 12,
                  "alignment": "center",
                  "alpha": 0.4
                },
                "styleWhen": [
                  {
                    "when": {
                      "key": "orderStep",
                      "gt": 0
                    },
                    "style": {
                      "alpha": 1
                    }
                  }
                ],
                "children": [
                  {
                    "type": "icon",
                    "name": "check_circle",
                    "contentDescription": "Packed"
                  },
                  {
                    "type": "text",
                    "text": "Packed",
                    "style": {
                      "textStyle": "bodyLarge"
                    }
                  }
                ]
              },
              {
                "type": "row",
                "testTag": "order_step_2",
                "style": {
                  "spacing": 12,
                  "alignment": "center",
                  "alpha": 0.4
                },
                "styleWhen": [
                  {
                    "when": {
                      "key": "orderStep",
                      "gt": 1
                    },
                    "style": {
                      "alpha": 1
                    }
                  }
                ],
                "children": [
                  {
                    "type": "icon",
                    "name": "check_circle",
                    "contentDescription": "Out for delivery"
                  },
                  {
                    "type": "text",
                    "text": "Out for delivery",
                    "style": {
                      "textStyle": "bodyLarge"
                    }
                  }
                ]
              },
              {
                "type": "row",
                "testTag": "order_step_3",
                "style": {
                  "spacing": 12,
                  "alignment": "center",
                  "alpha": 0.4
                },
                "styleWhen": [
                  {
                    "when": {
                      "key": "orderStep",
                      "gt": 2
                    },
                    "style": {
                      "alpha": 1
                    }
                  }
                ],
                "children": [
                  {
                    "type": "icon",
                    "name": "home",
                    "contentDescription": "Delivered"
                  },
                  {
                    "type": "text",
                    "text": "Delivered",
                    "style": {
                      "textStyle": "bodyLarge"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "text",
            "testTag": "order_live",
            "text": "Step {orderStep} of 3",
            "semantics": {
              "liveRegion": "polite"
            },
            "style": {
              "textStyle": "labelMedium",
              "padding": {
                "start": 16,
                "end": 16,
                "top": 16,
                "bottom": 16
              }
            }
          }
        ]
      }
    }
  }
}
