                    {
                      "type": "box",
                      "style": {
                        "width": {
                          "dp": 240
                        },
                        "height": {
                          "dp": 200
                        },
                        "background": "surfaceVariant",
                        "cornerRadius": "medium",
                        "alignment": "center"
                      },
                      "children": [
                        {
                          "type": "text",
                          "text": "Detail",
                          "style": {
                            "textStyle": "titleMedium"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": "{selectedTitle}",
                  "semantics": {
                    "heading": true
                  },
                  "style": {
                    "textStyle": "headlineSmall"
                  }
                },
                {
                  "type": "text",
                  "testTag": "detail_price",
                  "text": "{derived:selectedPriceText}",
                  "style": {
                    "textStyle": "titleLarge"
                  }
                },
                {
                  "type": "text",
                  "text": "★ {selectedRating}",
                  "style": {
                    "textStyle": "labelLarge"
                  }
                },
                {
                  "type": "select",
                  "testTag": "variant_select",
                  "stateKey": "variant",
                  "label": "Size",
                  "options": [
                    {
                      "value": "small",
                      "label": "Small"
                    },
                    {
                      "value": "medium",
                      "label": "Medium"
                    },
                    {
                      "value": "large",
                      "label": "Large"
                    }
                  ]
                },
                {
                  "type": "button",
                  "testTag": "add_to_cart",
                  "label": "Add to cart",
                  "icon": "add_shopping_cart",
                  "visibleWhen": {
                    "key": "selectedId",
                    "equals": "mug"
                  },
                  "onTap": [
                    {
                      "type": "increment",
                      "key": "qty_mug"
                    },
                    {
                      "type": "increment",
                      "key": "cartCount"
                    },
                    {
                      "type": "emit",
                      "name": "added_to_cart",
                      "context": {
                        "product": {
                          "value": "mug"
                        },
                        "variant": {
                          "state": "variant"
                        }
                      }
                    },
                    {
                      "type": "setState",
                      "key": "addedToast",
                      "value": true
                    }
                  ]
                },
                {
                  "type": "button",
                  "testTag": "add_to_cart",
                  "label": "Add to cart",
                  "icon": "add_shopping_cart",
                  "visibleWhen": {
                    "key": "selectedId",
                    "equals": "tote"
                  },
                  "onTap": [
                    {
                      "type": "increment",
                      "key": "qty_tote"
                    },
                    {
                      "type": "increment",
                      "key": "cartCount"
                    },
                    {
                      "type": "emit",
                      "name": "added_to_cart",
                      "context": {
                        "product": {
                          "value": "tote"
                        },
                        "variant": {
                          "state": "variant"
                        }
                      }
                    },
                    {
                      "type": "setState",
                      "key": "addedToast",
                      "value": true
                    }
                  ]
                },
                {
                  "type": "button",
                  "testTag": "add_to_cart",
                  "label": "Add to cart",
                  "icon": "add_shopping_cart",
                  "visibleWhen": {
                    "key": "selectedId",
                    "equals": "lamp"
                  },
                  "onTap": [
                    {
                      "type": "increment",
                      "key": "qty_lamp"
                    },
                    {
                      "type": "increment",
                      "key": "cartCount"
                    },
                    {
                      "type": "emit",
                      "name": "added_to_cart",
                      "context": {
                        "product": {
                          "value": "lamp"
                        },
                        "variant": {
                          "state": "variant"
                        }
                      }
                    },
                    {
                      "type": "setState",
                      "key": "addedToast",
                      "value": true
                    }
                  ]
                },
                {
                  "type": "button",
                  "testTag": "add_to_cart",
                  "label": "Add to cart",
                  "icon": "add_shopping_cart",
                  "visibleWhen": {
                    "key": "selectedId",
                    "equals": "board"
                  },
                  "onTap": [
                    {
                      "type": "increment",
                      "key": "qty_board"
                    },
                    {
                      "type": "increment",
                      "key": "cartCount"
                    },
                    {
                      "type": "emit",
                      "name": "added_to_cart",
                      "context": {
                        "product": {
                          "value": "board"
                        },
                        "variant": {
                          "state": "variant"
                        }
                      }
                    },
                    {
                      "type": "setState",
                      "key": "addedToast",
                      "value": true
                    }
                  ]
                },
                {
                  "type": "button",
                  "testTag": "add_to_cart",
                  "label": "Add to cart",
                  "icon": "add_shopping_cart",
                  "visibleWhen": {
                    "key": "selectedId",
                    "equals": "pack"
                  },
                  "onTap": [
                    {
                      "type": "increment",
                      "key": "qty_pack"
                    },
                    {
                      "type": "increment",
                      "key": "cartCount"
                    },
                    {
                      "type": "emit",
                      "name": "added_to_cart",
                      "context": {
                        "product": {
                          "value": "pack"
                        },
                        "variant": {
                          "state": "variant"
                        }
                      }
                    },
                    {
                      "type": "setState",
