                  ]
                },
                {
                  "type": "snackbar",
                  "testTag": "added_toast",
                  "openWhen": {
                    "key": "addedToast",
                    "equals": true
                  },
                  "text": "Added to cart",
                  "durationMs": 3000,
                  "action": {
                    "label": "View cart",
                    "onTap": [
                      {
                        "type": "push",
                        "stack": "nav",
                        "screen": "cart"
                      }
                    ]
                  }
                }
              ]
            }
