      "cart": {
        "type": "column",
        "children": [
          {
            "type": "topAppBar",
            "testTag": "cart_bar",
            "title": "Cart",
            "navigationIcon": {
              "icon": "arrow_back",
              "label": "Back",
              "onTap": [
                {
                  "type": "pop",
                  "stack": "nav"
                }
              ]
            }
          },
          {
            "type": "column",
            "testTag": "cart_empty",
            "visibleWhen": {
