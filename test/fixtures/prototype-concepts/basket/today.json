  "root": {
    "type": "stack",
    "id": "nav",
    "start": "shop",
    "style": {
      "width": "fill",
      "height": "fill"
    },
    "screens": {
      "shop": {
        "type": "column",
        "style": {
          "weight": 1
        },
        "children": [
          {
            "type": "topAppBar",
            "testTag": "shop_bar",
            "title": "Basket",
            "actions": [
              {
                "icon": "shopping_cart",
                "label": "Cart, {cartCount} items",
                "onTap": [
                  {
                    "type": "push",
                    "stack": "nav",
                    "screen": "cart"
                  }
                ]
              }
            ]
          },
          {
            "type": "searchBar",
            "testTag": "search_bar",
            "stateKey": "query",
            "placeholder": "Search Basket",
            "leadingIcon": "search",
            "onSubmit": [
              {
                "type": "emit",
                "name": "search_submitted",
                "context": {
                  "query": {
                    "state": "query"
                  }
                }
              }
            ]
          },
          {
            "type": "text",
            "testTag": "search_note",
            "visibleWhen": {
              "key": "query",
              "lengthGt": 0
            },
            "text": "Showing everything: search-as-you-type needs a filter.",
            "style": {
              "textStyle": "bodySmall",
              "padding": {
                "start": 16,
                "end": 16,
                "top": 4,
                "bottom": 0
              }
            }
          },
          {
            "type": "segmentedButton",
            "testTag": "category_picker",
            "stateKey": "category",
            "options": [
              {
                "value": "all",
                "label": "All"
              },
              {
                "value": "kitchen",
                "label": "Kitchen"
              },
              {
                "value": "bags",
                "label": "Bags"
              },
              {
                "value": "home",
                "label": "Home"
              }
            ]
          },
          {
            "type": "segmentedButton",
            "testTag": "sort_picker",
            "stateKey": "sort",
            "options": [
              {
                "value": "featured",
                "label": "Featured"
              },
              {
                "value": "price",
                "label": "Price: low to high"
              }
            ]
          },
          {
            "type": "scroll",
            "testTag": "catalog_scroll",
            "style": {
              "weight": 1
            },
            "child": {
              "type": "column",
              "style": {
                "padding": {
                  "start": 16,
                  "end": 16,
                  "top": 16,
                  "bottom": 16
                }
              },
              "children": [
                {
                  "type": "grid",
                  "testTag": "catalog_featured",
                  "visibleWhen": {
                    "key": "sort",
                    "equals": "featured"
                  },
                  "columns": 2,
                  "style": {
                    "spacing": 12
                  },
                  "repeat": {
                    "items": {
                      "path": "/products"
                    },
                    "as": "item",
                    "key": "id",
                    "derive": {
                      "priceText": {
                        "of": {
                          "item": "price"
                        },
                        "format": {
                          "currency": {
                            "code": "USD"
                          }
                        },
                        "locale": "en-US"
                      }
                    }
                  },
                  "children": [
                    {
                      "type": "card",
                      "testTag": "product_card",
                      "variant": "outlined",
                      "visibleWhen": {
                        "any": [
                          {
                            "key": "category",
                            "equals": "all"
                          },
                          {
                            "key": "category",
                            "equals": "{item.category}"
                          }
                        ]
                      },
                      "onTap": [
                        {
                          "type": "setState",
                          "key": "selectedId",
                          "value": "{item.id}"
                        },
                        {
                          "type": "setState",
                          "key": "selectedTitle",
                          "value": "{item.title}"
                        },
                        {
                          "type": "setState",
                          "key": "selectedPrice",
                          "value": "{item.price}"
                        },
                        {
                          "type": "setState",
                          "key": "selectedRating",
                          "value": "{item.rating}"
                        },
                        {
                          "type": "setState",
                          "key": "variant",
                          "value": "medium"
                        },
                        {
                          "type": "push",
                          "stack": "nav",
                          "screen": "product"
                        }
                      ],
                      "children": [
                        {
                          "type": "column",
                          "style": {
                            "padding": {
                              "start": 12,
                              "end": 12,
                              "top": 12,
                              "bottom": 12
                            },
                            "spacing": 4
                          },
                          "children": [
                            {
                              "type": "box",
                              "style": {
                                "aspectRatio": 1,
                                "width": "fill",
                                "background": "surfaceVariant",
                                "cornerRadius": "small",
                                "alignment": "center"
                              },
                              "children": [
                                {
                                  "type": "icon",
                                  "name": "shopping_bag",
                                  "variant": "outlined",
                                  "contentDescription": "Product photo"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": "{item.title}",
                              "style": {
                                "textStyle": "titleSmall",
                                "maxLines": 1,
                                "overflow": "ellipsis"
                              }
                            },
                            {
                              "type": "text",
                              "testTag": "product_price",
                              "text": "{item.priceText}",
                              "style": {
                                "textStyle": "labelLarge"
                              }
                            },
                            {
                              "type": "text",
                              "text": "★ {item.rating}",
                              "style": {
                                "textStyle": "labelSmall"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "grid",
                  "testTag": "catalog_price",
                  "visibleWhen": {
                    "key": "sort",
                    "equals": "price"
                  },
                  "columns": 2,
                  "style": {
                    "spacing": 12
                  },
                  "repeat": {
                    "items": {
                      "path": "/byPrice"
                    },
                    "as": "item",
                    "key": "id",
                    "derive": {
                      "priceText": {
                        "of": {
                          "item": "price"
                        },
                        "format": {
                          "currency": {
                            "code": "USD"
                          }
                        },
                        "locale": "en-US"
                      }
                    }
                  },
                  "children": [
                    {
                      "type": "card",
                      "testTag": "product_card",
                      "variant": "outlined",
                      "visibleWhen": {
                        "any": [
                          {
                            "key": "category",
                            "equals": "all"
                          },
                          {
                            "key": "category",
                            "equals": "{item.category}"
                          }
                        ]
                      },
                      "onTap": [
                        {
                          "type": "setState",
                          "key": "selectedId",
                          "value": "{item.id}"
                        },
                        {
                          "type": "setState",
                          "key": "selectedTitle",
                          "value": "{item.title}"
                        },
                        {
                          "type": "setState",
                          "key": "selectedPrice",
                          "value": "{item.price}"
                        },
                        {
                          "type": "setState",
                          "key": "selectedRating",
                          "value": "{item.rating}"
                        },
                        {
                          "type": "setState",
                          "key": "variant",
                          "value": "medium"
                        },
                        {
                          "type": "push",
                          "stack": "nav",
                          "screen": "product"
                        }
                      ],
                      "children": [
                        {
                          "type": "column",
                          "style": {
                            "padding": {
                              "start": 12,
                              "end": 12,
                              "top": 12,
                              "bottom": 12
                            },
                            "spacing": 4
                          },
                          "children": [
                            {
                              "type": "box",
                              "style": {
                                "aspectRatio": 1,
                                "width": "fill",
                                "background": "surfaceVariant",
                                "cornerRadius": "small",
                                "alignment": "center"
                              },
                              "children": [
                                {
                                  "type": "icon",
                                  "name": "shopping_bag",
                                  "variant": "outlined",
                                  "contentDescription": "Product photo"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "text": "{item.title}",
                              "style": {
                                "textStyle": "titleSmall",
                                "maxLines": 1,
                                "overflow": "ellipsis"
                              }
                            },
                            {
                              "type": "text",
                              "testTag": "product_price",
                              "text": "{item.priceText}",
                              "style": {
                                "textStyle": "labelLarge"
                              }
                            },
                            {
                              "type": "text",
                              "text": "★ {item.rating}",
                              "style": {
                                "textStyle": "labelSmall"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "product": {
        "type": "column",
        "children": [
          {
            "type": "topAppBar",
            "testTag": "product_bar",
            "title": "{selectedTitle}",
