      "listing": {
        "type": "column",
        "children": [
          {
            "type": "topAppBar",
            "testTag": "listing_bar",
            "title": "{listingTitle}",
            "navigationIcon": {
              "icon": "arrow_back",
              "label": "Back",
              "onTap": [
                {
                  "type": "pop",
                  "stack": "nav"
                }
              ]
            }
          },
          {
            "type": "column",
            "style": {
              "padding": {
                "start": 16,
                "end": 16,
                "top": 16,
                "bottom": 16
              },
              "spacing": 12
            },
            "children": [
              {
                "type": "box",
                "testTag": "listing_map",
                "contentDescription": "Map of the pickup area",
                "style": {
                  "width": "fill",
                  "height": {
                    "dp": 160
                  },
                  "background": "surfaceContainerHigh",
                  "cornerRadius": "medium",
                  "alignment": "center"
                },
                "children": [
                  {
                    "type": "icon",
                    "name": "location_on",
                    "contentDescription": "Pickup area"
                  }
                ]
              },
              {
                "type": "text",
                "testTag": "listing_price",
                "text": "{derived:listingPriceText}",
                "style": {
                  "textStyle": "headlineSmall"
                }
              },
              {
                "type": "text",
                "text": "{listingDistance} away",
                "style": {
                  "textStyle": "bodyMedium"
                }
              },
              {
                "type": "button",
                "testTag": "message_seller",
