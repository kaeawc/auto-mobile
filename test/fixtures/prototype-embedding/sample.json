{
  "id": "embeddingSample",
  "window": { "placement": { "type": "fullscreen" } },
  "state": { "visits": 0, "status": "idle" },
  "data": { "greeting": { "text": "Hello from a prototype" } },
  "storage": { "version": 1, "keys": ["state:visits"] },
  "root": {
    "type": "column",
    "children": [
      { "type": "image", "asset": "hero" },
      { "type": "text", "text": "{data:/greeting/text}" },
      { "type": "text", "text": "Visits: {visits}" },
      {
        "type": "button",
        "label": "Visit",
        "onTap": [
          { "type": "increment", "key": "visits" },
          { "type": "setData", "path": "/data/greeting/text", "value": { "value": "Welcome back" } }
        ]
      },
      {
        "type": "button",
        "label": "Load",
        "onTap": [
          {
            "type": "request",
            "url": "http://10.0.2.2:8080/greeting",
            "into": "/data/greeting",
            "statusKey": "status"
          }
        ]
      }
    ]
  }
}
