        "durationMs": 2000
      },
      {
        "op": "play",
        "player": "s"
      },
      {
        "op": "advance",
        "ms": 2000
      },
      {
        "op": "seek",
        "player": "s",
        "positionMs": 500
      },
      {
        "op": "play",
        "player": "s"
      },
      {
        "op": "seek",
        "player": "s",
        "positionMs": 99999
      }
    ],
    "expected": {
      "events": [
        {
          "name": "media.statusChanged",
          "payload": {
