  },
  {
    "name": "released and unknown players and invalid events are refused without a change",
    "steps": [
      {
        "op": "load",
        "player": "a",
        "durationMs": 1000
      },
      {
        "op": "release",
        "player": "a"
      },
      {
        "op": "simulate",
        "event": "media.statusChanged",
        "data": {
          "player": "a",
          "status": "ready"
        },
        "error": "unknown_player"
      },
      {
        "op": "release",
        "player": "a",
        "error": "unknown_player"
      },
      {
        "op": "load",
        "player": "b",
        "durationMs": 1000
      },
      {
        "op": "simulate",
        "event": "media.statusChanged",
        "data": {
          "player": "b",
          "status": "error"
        },
        "error": "invalid_args"
      },
      {
        "op": "simulate",
        "event": "media.error",
        "data": {
          "player": "b",
          "code": "bogus"
        },
        "error": "invalid_args"
      }
    ],
    "expected": {
      "events": [
        {
          "name": "media.statusChanged",
          "payload": {
            "player": "a",
            "status": "ready",
            "playing": false,
            "positionMs": 0
          }
        },
        {
          "name": "media.statusChanged",
          "payload": {
            "player": "b",
            "status": "ready",
            "playing": false,
            "positionMs": 0
          }
        }
      ],
      "state": {
        "players": {
          "b": {
            "playing": false,
            "positionMs": 0,
            "durationMs": 1000,
            "buffering": false,
            "status": "ready"
          }
        }
      }
    }
  }
]
