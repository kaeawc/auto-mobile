{
  "name": "Simulated entitlement changes move a subscription through its lifecycle",
  "products": [
    {
      "id": "pro_monthly",
      "kind": "subscription"
    },
    {
      "id": "no_ads",
      "kind": "nonConsumable"
    },
    {
      "id": "coins_100",
      "kind": "consumable"
    }
  ],
  "state": {
    "entitlements": {
      "pro_monthly": "active",
      "no_ads": "active"
