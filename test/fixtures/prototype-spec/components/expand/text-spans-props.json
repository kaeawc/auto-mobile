{
  "spec": {
    "id": "rich",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "use",
      "component": "label",
      "props": {
        "title": "Terms",
        "event": "terms"
      }
    },
    "components": {
      "label": {
        "root": {
          "type": "text",
          "spans": [
            {
              "text": "{props.title}",
              "onTap": [
                {
                  "type": "emit",
                  "name": "{props.event}"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "expanded": {
    "id": "rich",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "text",
      "spans": [
        {
          "text": "Terms",
          "onTap": [
            {
              "type": "emit",
              "name": "terms"
            }
          ]
        }
      ]
    }
  }
}
