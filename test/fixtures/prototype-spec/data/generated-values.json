[
  {
    "name": "generated id and fixed UTC clock",
    "initialData": {
      "rows": []
    },
    "ids": ["id-1", "id-2"],
    "clockMs": 1700000000000,
    "actions": [
      {
        "type": "appendData",
        "path": "/data/rows",
        "value": {
          "value": {
            "id": {
              "generate": "id"
            },
            "status": "sending",
            "at": {
              "now": "epochMs"
            }
          }
        }
      },
      {
        "type": "setData",
        "path": "/data/iso",
        "value": {
          "now": "iso"
        }
      },
      {
        "type": "setData",
        "path": "/data/rows",
        "where": {
          "field": "id",
          "equals": {
            "lastGenerated": true
          }
        },
        "member": "status",
        "value": {
          "value": "sent"
        }
      }
    ],
    "mockResponses": [],
    "expected": {
      "data": {
        "rows": [
          {
            "id": "id-1",
            "status": "sent",
            "at": 1700000000000
          }
        ],
        "iso": "2023-11-14T22:13:20.000Z"
      }
    }
  },
