  {
    "name": "keyed request into member",
    "initialData": {
      "rows": [
        {
          "id": "id-1"
        }
      ]
    },
    "ids": ["id-1", "id-2"],
    "clockMs": 1700000000000,
    "actions": [
      {
        "type": "request",
        "url": "https://example.test/result",
        "into": "/data/rows",
        "where": {
          "field": "id",
          "equals": {
            "value": "id-1"
          }
        },
        "member": "result"
      }
    ],
    "mockResponses": [
      {
        "status": 200,
        "body": {
          "ok": true
        }
      }
    ],
    "expected": {
      "data": {
        "rows": [
          {
            "id": "id-1",
            "result": {
              "ok": true
            }
          }
        ],
        "rows__meta": {
          "status": 200,
          "headers": {},
          "durationMs": 0
        }
      }
    }
  },
