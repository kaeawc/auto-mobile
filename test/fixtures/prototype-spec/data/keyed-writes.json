[
  {
    "name": "member set",
    "before": {
      "items": [
        {
          "id": 1,
          "text": "one"
        },
        {
          "id": 2,
          "text": "two"
        }
      ]
    },
    "write": {
      "op": "set",
      "path": "/data/items",
      "where": {
        "field": "id",
        "equals": 2
      },
      "value": "edit",
      "member": "text"
    },
    "expected": {
      "data": {
        "items": [
          {
            "id": 1,
            "text": "one"
          },
          {
            "id": 2,
            "text": "edit"
          }
        ]
      },
      "trimmed": 0
    }
  },
