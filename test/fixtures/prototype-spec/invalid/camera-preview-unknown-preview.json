{
  "spec": {
    "id": "v",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "lens": "back",
      "flash": "auto",
      "zoom": 0.5
    },
    "requires": {
      "platform": ["camera"],
      "permissions": [
        {
          "name": "camera",
          "purpose": "Show the viewfinder"
        }
      ]
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "cameraPreview",
          "id": "vf",
          "lensKey": "lens",
          "flashKey": "flash",
          "zoomKey": "zoom",
          "aspectRatio": "16:9",
          "contentScale": "fit",
          "mode": "video"
        },
        {
          "type": "button",
          "label": "Flip",
          "onTap": [
            {
              "type": "platform",
              "call": "camera.takePhoto",
              "args": {
                "preview": {
                  "value": "other"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.children[1].onTap[0].args.preview.value",
  "expectedMessage": "Unknown camera preview"
}
