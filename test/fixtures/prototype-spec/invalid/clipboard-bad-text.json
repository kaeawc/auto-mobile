{
  "spec": {
    "id": "clipboard",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["clipboard"]
    },
    "root": {
      "type": "button",
      "label": "Clipboard",
      "onTap": [
        {
          "type": "platform",
          "call": "clipboard.copy",
          "args": {
            "text": {
              "value": 42
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.text.value",
  "expectedMessage": "Invalid string value"
}
