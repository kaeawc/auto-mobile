{
  "spec": {
    "id": "formats",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "price": 1234.5
    },
    "state": {
      "ratio": 0.256
    },
    "derive": {
      "price": {
        "of": {
          "data": "/price"
        },
        "format": {
          "number": {},
          "percent": {}
        }
      },
      "percent": {
        "of": {
          "state": "ratio"
        },
        "format": {
          "percent": {
            "maxFraction": 1
          }
        }
      },
      "date": {
        "of": {
          "value": "2026-01-05"
        },
        "format": {
          "date": {}
        },
        "locale": "en-GB",
        "timeZone": "UTC"
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "{derived:price} {derived:percent} {derived:date}"
        },
        {
          "type": "column",
          "repeat": {
            "items": [
              {
                "createdAt": "2026-01-05"
              }
            ],
            "as": "item",
            "derive": {
              "createdAtText": {
                "of": {
                  "item": "createdAt"
                },
                "format": {
                  "date": {}
                }
              }
            }
          },
          "children": [
            {
              "type": "text",
              "text": "{item.createdAtText}"
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "derive.price.format.number",
  "expectedMessage": "Exactly one of number, compact, currency, percent, date, time, relative is required"
}
