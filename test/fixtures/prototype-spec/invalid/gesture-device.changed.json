{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["notifications", "device", "map", "sensors", "biometric"],
      "permissions": [
        {
          "name": "notifications",
          "purpose": "Messages"
        }
      ]
    },
    "root": {
      "type": "spacer"
    },
    "notifications": {
      "channels": [
        {
          "id": "messages",
          "name": "Messages",
          "importance": "default"
        }
      ]
    },
    "platform": {
      "on": {
        "device.changed": [
          {
            "type": "platform",
            "call": "notifications.post",
            "args": {
              "id": {
                "value": "msg"
              },
              "channel": {
                "value": "messages"
              },
              "title": {
                "value": "Hi"
              }
            }
          }
        ]
      }
    }
  },
  "expectedPath": "platform.on[\"device.changed\"][0]",
  "expectedMessage": "Side-effecting platform call notifications.post needs a user gesture: move it into onTap, onLongPress, onDoubleTap or onSubmit"
}
