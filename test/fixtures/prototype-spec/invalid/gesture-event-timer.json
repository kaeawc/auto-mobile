{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["notifications", "device", "map", "sensors", "biometric"],
      "permissions": [
        {
          "name": "notifications",
          "purpose": "Messages"
        }
      ]
    },
    "root": {
      "type": "spacer"
    },
    "notifications": {
      "channels": [
        {
          "id": "messages",
          "name": "Messages",
          "importance": "default"
        }
      ]
    },
    "platform": {
      "on": {
        "notifications.opened": [
          {
            "type": "startTimer",
            "id": "tick",
            "afterMs": 100,
            "actions": [
              {
                "type": "platform",
                "call": "notifications.post",
                "args": {
                  "id": {
                    "value": "msg"
                  },
                  "channel": {
                    "value": "messages"
                  },
                  "title": {
                    "value": "Hi"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "expectedPath": "platform.on[\"notifications.opened\"][0].actions[0]",
  "expectedMessage": "Side-effecting platform call notifications.post needs a user gesture: move it into onTap, onLongPress, onDoubleTap or onSubmit"
}
