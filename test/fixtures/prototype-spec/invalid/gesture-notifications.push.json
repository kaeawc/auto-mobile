{
  "spec": {
    "id": "np",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "messages": []
    },
    "requires": {
      "platform": ["notifications"],
      "permissions": [
        {
          "name": "notifications",
          "purpose": "Tell you about new messages"
        }
      ]
    },
    "notifications": {
      "channels": [
        {
          "id": "chat",
          "name": "Chat",
          "importance": "high"
        }
      ]
    },
    "platform": {
      "on": {
        "notifications.push": [
          {
            "type": "appendData",
            "path": "/data/messages",
            "value": {
              "event": "/data"
            }
          },
          {
            "type": "setState",
            "key": "lastSender",
            "value": {
              "event": "/data/sender"
            }
          },
          {
            "type": "platform",
            "call": "notifications.post",
            "args": {
              "id": {
                "event": "/data/id"
              },
              "channel": {
                "value": "chat"
              },
              "title": {
                "event": "/data/sender"
              },
              "body": {
                "event": "/data/text"
              }
            }
          }
        ]
      }
    },
    "root": {
      "type": "text",
      "text": "Messages"
    },
    "state": {
      "lastSender": ""
    }
  },
  "expectedPath": "platform.on[\"notifications.push\"][2]",
  "expectedMessage": "Side-effecting platform call notifications.post needs a user gesture: move it into onTap, onLongPress, onDoubleTap or onSubmit"
}
