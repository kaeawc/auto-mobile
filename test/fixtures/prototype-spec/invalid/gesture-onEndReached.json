{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "list",
      "repeat": {
        "items": {
          "path": "/rows"
        },
        "as": "item",
        "key": "id"
      },
      "children": [
        {
          "type": "text",
          "text": "{item.title}"
        }
      ],
      "onEndReached": [
        {
          "type": "platform",
          "call": "share.open",
          "args": {
            "text": {
              "value": "Hello {name} {data:/post/title} {item.name} {index}"
            }
          }
        }
      ]
    },
    "data": {
      "rows": [
        {
          "id": "row",
          "title": "Hi"
        }
      ]
    }
  },
  "expectedPath": "root.onEndReached[0]",
  "expectedMessage": "Side-effecting platform call share.open needs a user gesture: move it into onTap, onLongPress, onDoubleTap or onSubmit"
}
