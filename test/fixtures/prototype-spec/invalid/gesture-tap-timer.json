{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "button",
      "label": "Go",
      "onTap": [
        {
          "type": "startTimer",
          "id": "tick",
          "afterMs": 100,
          "actions": [
            {
              "type": "platform",
              "call": "share.open",
              "args": {
                "text": {
                  "value": "Hello {name} {data:/post/title} {item.name} {index}"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].actions[0]",
  "expectedMessage": "Side-effecting platform call share.open needs a user gesture: move it into onTap, onLongPress, onDoubleTap or onSubmit"
}
