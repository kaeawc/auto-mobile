{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["notifications", "device", "map", "sensors", "biometric"],
      "permissions": [
        {
          "name": "notifications",
          "purpose": "Messages"
        }
      ]
    },
    "root": {
      "type": "spacer"
    },
    "notifications": {
      "channels": [
        {
          "id": "messages",
          "name": "Messages",
          "importance": "default"
        }
      ]
    },
    "platform": {
      "on": {
        "notifications.opened": [
          {
            "type": "startTimer",
            "id": "tick",
            "afterMs": 100,
            "actions": [
              {
                "type": "platform",
                "call": "biometric.authenticate",
                "args": {
                  "title": {
                    "event": "/title"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "expectedPath": "platform.on[\"notifications.opened\"][0].actions[0].args.title.event",
  "expectedMessage": "{event} is unavailable in startTimer actions: copy the needed event fields into data or state before starting the timer"
}
