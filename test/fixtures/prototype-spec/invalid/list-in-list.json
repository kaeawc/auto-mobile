{
  "spec": {
    "id": "feed",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "feed": {
        "items": [
          {
            "id": 1,
            "title": "One"
          },
          {
            "id": 2,
            "title": "Two"
          }
        ]
      },
      "page": {
        "next": "p2"
      }
    },
    "state": {
      "refreshing": false,
      "feedStatus": "idle"
    },
    "root": {
      "type": "list",
      "repeat": {
        "items": {
          "path": "/feed/items"
        },
        "as": "post",
        "key": "id"
      },
      "children": [
        {
          "type": "text",
          "text": "{post.title}"
        }
      ],
      "header": {
        "type": "box",
        "children": [
          {
            "type": "list",
            "repeat": {
              "items": {
                "path": "/feed/items"
              },
              "as": "post",
              "key": "id"
            },
            "children": [
              {
                "type": "text",
                "text": "{post.title}"
              }
            ]
          }
        ]
      }
    }
  },
  "expectedPath": "root.header.children[0]",
  "expectedMessage": "A list cannot sit inside another list"
}
