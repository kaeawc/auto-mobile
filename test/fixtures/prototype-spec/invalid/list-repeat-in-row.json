{
  "spec": {
    "id": "feed",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "feed": {
        "items": [
          {
            "id": 1,
            "title": "One"
          },
          {
            "id": 2,
            "title": "Two"
          }
        ]
      },
      "page": {
        "next": "p2"
      }
    },
    "state": {
      "refreshing": false,
      "feedStatus": "idle"
    },
    "root": {
      "type": "list",
      "repeat": {
        "items": {
          "path": "/feed/items"
        },
        "as": "post",
        "key": "id"
      },
      "children": [
        {
          "type": "column",
          "repeat": {
            "items": [
              {
                "id": 1
              }
            ],
            "as": "item"
          },
          "children": []
        }
      ]
    }
  },
  "expectedPath": "root.children[0].repeat",
  "expectedMessage": "Nested repeat is not supported"
}
