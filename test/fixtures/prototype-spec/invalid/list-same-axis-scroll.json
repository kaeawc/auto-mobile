{
  "spec": {
    "id": "feed",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "feed": {
        "items": [
          {
            "id": 1,
            "title": "One"
          },
          {
            "id": 2,
            "title": "Two"
          }
        ]
      },
      "page": {
        "next": "p2"
      }
    },
    "state": {
      "refreshing": false,
      "feedStatus": "idle"
    },
    "root": {
      "type": "list",
      "repeat": {
        "items": {
          "path": "/feed/items"
        },
        "as": "post",
        "key": "id"
      },
      "children": [
        {
          "type": "text",
          "text": "{post.title}"
        }
      ],
      "footer": {
        "type": "scroll",
        "child": {
          "type": "spacer"
        }
      }
    }
  },
  "expectedPath": "root.footer",
  "expectedMessage": "A scroll cannot sit inside a list on the same axis"
}
