{
  "spec": {
    "id": "loops",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "text",
      "text": "Attention",
      "attentionLoop": {
        "effect": "spin",
        "periodMs": 800
      },
      "styleWhen": [
        {
          "when": {
            "key": "on",
            "equals": true
          },
          "style": {
            "rotation": 1
          }
        }
      ]
    },
    "state": {
      "on": true
    }
  },
  "expectedPath": "root.attentionLoop",
  "expectedMessage": "spin loop cannot set style.rotation"
}
