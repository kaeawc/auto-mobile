{
  "spec": {
    "id": "v",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "cues": {
        "en": [
          {
            "startMs": 0,
            "endMs": 1500,
            "text": "Hello"
          },
          {
            "startMs": 1500,
            "endMs": 3000
          }
        ]
      }
    },
    "requires": {
      "platform": ["media"]
    },
    "media": {
      "players": {
        "main": {
          "kind": "video",
          "source": {
            "asset": "trailer"
          }
        }
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "videoPlayer",
          "id": "hero",
          "player": "main",
          "captions": [
            {
              "id": "en",
              "language": "en",
              "label": "English",
              "source": {
                "data": "/data/cues/en"
              }
            },
            {
              "id": "es",
              "language": "es-MX",
              "label": "Espa\u00f1ol",
              "source": {
                "asset": "trailerEs"
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "{platform:/media/players/main/captionTrack}"
        },
        {
          "type": "button",
          "label": "Spanish",
          "onTap": [
            {
              "type": "platform",
              "call": "media.setCaptions",
              "args": {
                "player": {
                  "value": "main"
                },
                "track": {
                  "value": "es"
                }
              }
            }
          ]
        },
        {
          "type": "button",
          "label": "Off",
          "onTap": [
            {
              "type": "platform",
              "call": "media.setCaptions",
              "args": {
                "player": {
                  "value": "main"
                },
                "track": {
                  "value": ""
                }
              }
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "data.cues.en[1].text",
  "expectedMessage": "Required property"
}
