{
  "spec": {
    "id": "menus",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "open": "yes"
    },
    "root": {
      "type": "menu",
      "testTag": "overflow",
      "openWhen": {
        "key": "open",
        "equals": true
      },
      "items": [
        {
          "label": "Share",
          "icon": "share",
          "trailingText": "Send",
          "onTap": [
            {
              "type": "emit",
              "name": "share"
            },
            {
              "type": "setState",
              "key": "open",
              "value": false
            }
          ]
        },
        {
          "type": "divider"
        },
        {
          "label": "Unavailable",
          "enabled": false
        }
      ]
    }
  },
  "expectedPath": "root.openWhen.key",
  "expectedMessage": "Menu requires a boolean state key"
}
