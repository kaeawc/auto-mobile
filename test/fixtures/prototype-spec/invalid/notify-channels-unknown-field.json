            },
            "title": {
              "value": "Ada"
            }
          }
        }
      ]
    },
    "notifications": {
      "channels": [
        {
          "id": "messages",
          "name": "Messages",
          "importance": "high",
          "description": "Direct messages",
          "showBadge": true,
          "sound": "ding"
        },
        {
          "id": "promos",
          "name": "Offers",
          "importance": "low"
        }
      ]
    }
  },
  "expectedPath": "notifications.channels[0].sound"
