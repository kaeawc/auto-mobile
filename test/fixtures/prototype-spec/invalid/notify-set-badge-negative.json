{
  "spec": {
    "id": "n15",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "postStatus": ""
    },
    "requires": {
      "platform": ["notifications"],
      "permissions": [
        {
          "name": "notifications",
          "purpose": "Tell you about new messages"
        }
      ]
    },
    "root": {
      "type": "button",
      "label": "Notify",
      "onTap": [
        {
          "type": "platform",
          "call": "notifications.setBadge",
          "args": {
            "count": {
              "value": -1
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.count.value"
}
