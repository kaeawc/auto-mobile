{
  "spec": {
    "id": "stack-patterns",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "home",
      "transition": "sharedAxisX",
      "screens": {
        "home": {
          "type": "text",
          "text": "Home",
          "onTap": [
            {
              "type": "push",
              "stack": "nav",
              "screen": "detail",
              "transition": "zoom",
              "source": "absent"
            }
          ],
          "ios": {
            "bottomAccessory": {
              "type": "text",
              "text": "Hidden",
              "sharedKey": "absent"
            }
          }
        },
        "detail": {
          "type": "text",
          "text": "Detail"
        }
      }
    }
  },
  "expectedPath": "root.screens[\"home\"].onTap[0].source"
}
