{
  "spec": {
    "id": "u9",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["links"]
    },
    "root": {
      "type": "button",
      "label": "Open",
      "onTap": [
        {
          "type": "platform",
          "call": "links.open",
          "args": {
            "url": {
              "value": "https://example."
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.url.value"
}
