{
  "spec": {
    "id": "r",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "draft": {
        "voiceNote": {}
      }
    },
    "state": {
      "recStatus": ""
    },
    "requires": {
      "platform": ["audioRecorder"],
      "permissions": [
        {
          "name": "microphone",
          "purpose": "Record a voice note"
        }
      ]
    },
    "platform": {
      "on": {
        "audioRecorder.statusChanged": [
          {
            "type": "emit",
            "name": "recorder_status"
          }
        ]
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "{platform:/audioRecorder/peak}"
        },
        {
          "type": "button",
          "label": "Hold to record",
          "onTap": [
            {
              "type": "platform",
              "call": "audioRecorder.start",
              "args": {
                "maxDurationMs": {
                  "value": 60000
                }
              }
            }
          ]
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "platform",
              "call": "audioRecorder.stop",
              "args": {},
              "into": "/data/draft/voiceNote",
              "statusKey": "recStatus"
            }
          ]
        },
        {
          "type": "button",
          "label": "Discard",
          "onTap": [
            {
              "type": "platform",
              "call": "audioRecorder.cancel",
              "args": {}
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.children[0].text",
  "expectedMessage": "Unknown platform state /audioRecorder/peak"
}
