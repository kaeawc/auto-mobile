{
  "spec": {
    "id": "b7",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "authStatus": "",
      "unlocked": false,
      "failures": 0
    },
    "requires": {
      "platform": ["biometric"]
    },
    "platform": {
      "on": {
        "biometric.succeeded": [
          {
            "type": "increment",
            "key": "failures"
          }
        ]
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "Failed attempts {failures}"
        },
        {
          "type": "button",
          "label": "Unlock",
          "onTap": [
            {
              "type": "platform",
              "call": "biometric.authenticate",
              "args": {
                "title": {
                  "value": "Unlock"
                }
              },
              "statusKey": "authStatus",
              "onSuccess": [
                {
                  "type": "setState",
                  "key": "unlocked",
                  "value": true
                }
              ],
              "onError": [
                {
                  "type": "setState",
                  "key": "unlocked",
                  "value": false
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "platform.on[\"biometric.succeeded\"]"
}
