{
  "spec": {
    "id": "k3",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "draft": {
        "picked": [],
        "photo": {}
      }
    },
    "state": {
      "pickStatus": ""
    },
    "requires": {
      "platform": ["camera"]
    },
    "root": {
      "type": "button",
      "label": "Go",
      "onTap": [
        {
          "type": "platform",
          "call": "camera.capture",
          "args": {
            "media": {
              "value": "video"
            },
            "maxDurationMs": {
              "value": 600001
            }
          },
          "into": "/data/draft/photo",
          "statusKey": "pickStatus"
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.maxDurationMs.value"
}
