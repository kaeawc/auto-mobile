{
  "spec": {
    "id": "m6",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "purchase": {}
    },
    "state": {
      "buyStatus": "",
      "failed": false,
      "changes": 0
    },
    "requires": {
      "platform": ["commerce"]
    },
    "platform": {
      "on": {
        "commerce.purchased": [
          {
            "type": "increment",
            "key": "changes"
          }
        ]
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "Entitlement changes {changes}"
        },
        {
          "type": "button",
          "label": "Go Pro",
          "onTap": [
            {
              "type": "platform",
              "call": "commerce.purchase",
              "args": {
                "productId": {
                  "value": "pro_monthly"
                }
              },
              "into": "/data/purchase",
              "statusKey": "buyStatus",
              "onError": [
                {
                  "type": "setState",
                  "key": "failed",
                  "value": true
                }
              ]
            }
          ]
        },
        {
          "type": "button",
          "label": "Restore",
          "onTap": [
            {
              "type": "platform",
              "call": "commerce.restore",
              "args": {}
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "platform.on[\"commerce.purchased\"]"
}
