{
  "spec": {
    "id": "f3",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "recipient": {}
    },
    "state": {
      "pickStatus": ""
    },
    "requires": {
      "platform": ["contacts"]
    },
    "root": {
      "type": "button",
      "label": "Go",
      "onTap": [
        {
          "type": "platform",
          "call": "contacts.pick",
          "args": {
            "fields": {
              "value": ["name", "address"]
            }
          },
          "into": "/data/recipient",
          "statusKey": "pickStatus"
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.fields.value[1]"
}
