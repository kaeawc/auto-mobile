{
  "spec": {
    "id": "a",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["test"]
    },
    "root": {
      "type": "button",
      "label": "Go",
      "onTap": [
        {
          "type": "platform",
          "call": "test.echo",
          "args": {
            "message": {
              "event": "/x"
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.message.event",
  "expectedMessage": "{event} is only available inside a platform.on handler"
}
