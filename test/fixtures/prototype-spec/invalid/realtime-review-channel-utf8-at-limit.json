{
  "spec": {
    "id": "channel-argument",
    "requires": {
      "platform": ["realtime"]
    },
    "channels": {
      "chat": {
        "kind": "websocket",
        "url": "wss://example.com"
      }
    },
    "root": {
      "type": "button",
      "label": "Connect",
      "onTap": [
        {
          "type": "platform",
          "call": "realtime.connect",
          "args": {
            "channel": {
              "value": "éééééééééééééééééééééééééééééééé"
            }
          }
        }
      ]
    },
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    }
  },
  "expectedPath": "root.onTap[0].args.channel",
  "expectedMessage": "channel must name a declared channel"
}
