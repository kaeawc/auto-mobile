{
  "spec": {
    "id": "review",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["realtime"]
    },
    "state": {
      "secret": "",
      "s": ""
    },
    "data": {
      "rows": []
    },
    "channels": {
      "c": {
        "kind": "websocket",
        "url": "wss://example.com",
        "via": "device",
        "routes": [
          {
            "actions": [
              {
                "type": "setData",
                "path": "/data/result",
                "value": {
                  "state": "secret"
                }
              }
            ]
          }
        ]
      }
    },
    "root": {
      "type": "textField",
      "stateKey": "secret",
      "secure": true
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "channels.c.routes[0].actions[0].value.state",
  "expectedMessage": "Secure value cannot be bound into an action payload"
}
