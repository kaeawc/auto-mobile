{
  "spec": {
    "id": "review",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["realtime"]
    },
    "state": {
      "secret": "",
      "s": ""
    },
    "data": {
      "rows": []
    },
    "channels": {
      "c": {
        "kind": "websocket",
        "url": "wss://example.com",
        "via": "device"
      }
    },
    "root": {
      "type": "textField",
      "stateKey": "secret",
      "secure": true,
      "onTap": [
        {
          "type": "platform",
          "call": "realtime.send",
          "args": {
            "channel": "c",
            "body": {
              "value": {
                "text": ""
              }
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.body.value",
  "expectedMessage": "realtime.send body exceeds the byte limit"
}
