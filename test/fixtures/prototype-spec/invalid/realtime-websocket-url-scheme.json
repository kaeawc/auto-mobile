{
  "spec": {
    "id": "realtime",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["realtime"]
    },
    "state": {
      "chatStatus": "idle",
      "peerTyping": false,
      "unread": 0,
      "roomId": "general"
    },
    "data": {
      "messages": [],
      "driver": {}
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "Status {platform:/realtime/chat/status}"
        },
        {
          "type": "text",
          "text": "Unread {unread}"
        }
      ]
    },
    "channels": {
      "chat": {
        "kind": "websocket",
        "url": "https://chat.example.com/room",
        "protocols": ["chat.v1"],
        "headers": {
          "Authorization": "Bearer {token}"
        },
        "via": "host",
        "connect": "onShow",
        "statusKey": "chatStatus",
        "reconnect": {
          "maxAttempts": 8,
          "initialDelayMs": 500,
          "maxDelayMs": 30000
        },
        "decode": "json",
        "routes": [
          {
            "when": {
              "pointer": "/type",
              "equals": "message"
            },
            "actions": [
              {
                "type": "upsertData",
                "path": "/data/messages",
                "key": "/id",
                "value": {
                  "event": "/message"
                },
                "maxItems": 200
              },
              {
                "type": "increment",
                "key": "unread"
              }
            ]
          },
          {
            "when": {
              "pointer": "/type",
              "equals": "typing"
            },
            "actions": [
              {
                "type": "setState",
                "key": "peerTyping",
                "value": {
                  "event": "/typing"
                }
              }
            ]
          }
        ],
        "onOpen": [],
        "onClose": [],
        "onError": []
      },
      "driver": {
        "kind": "sse",
        "url": "https://api.example.com/trips/{tripId}/events",
        "routes": [
          {
            "when": {
              "event": "location"
            },
            "actions": [
              {
                "type": "setData",
                "path": "/data/driver",
                "value": {
                  "event": ""
                }
              }
            ]
          }
        ]
      }
    }
  },
  "expectedPath": "channels.chat.url",
  "expectedMessage": "A websocket channel url must be an absolute ws or wss URL"
}
