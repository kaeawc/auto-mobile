{
  "spec": {
    "id": "prototype",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "x",
          "styleWhen": [
            {
              "when": {
                "key": "k",
                "equals": "{item.zzz}"
              },
              "style": {
                "alpha": 0.5
              }
            }
          ]
        }
      ],
      "repeat": {
        "items": [
          {
            "id": "a",
            "label": "Alpha",
            "price": 3,
            "on": true
          },
          {
            "id": "b",
            "label": "Beta",
            "price": 4.5,
            "on": false
          }
        ],
        "as": "item"
      }
    },
    "state": {
      "k": "a"
    }
  },
  "expectedPath": "root.children[0].styleWhen[0].when.equals"
}
