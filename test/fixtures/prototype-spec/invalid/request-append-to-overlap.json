{
  "spec": {
    "id": "feed",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "items": [],
      "page": {}
    },
    "root": {
      "type": "button",
      "label": "Load",
      "onTap": [
        {
          "type": "request",
          "url": "http://localhost/feed",
          "append": {
            "from": "/items",
            "to": "/data/items"
          },
          "into": "/data/items"
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].append.to",
  "expectedMessage": "append.to must not overlap into"
}
