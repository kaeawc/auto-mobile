{
  "spec": {
    "id": "routes-review",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "home",
      "screens": {
        "home": {
          "type": "text",
          "text": "Home"
        },
        "detail": {
          "type": "text",
          "text": "Detail"
        }
      },
      "routes": {
        "detail": {}
      }
    },
    "requires": {
      "platform": ["test"]
    },
    "platform": {
      "on": {
        "test.tick": [
          {
            "type": "emit",
            "name": "{route.x}"
          }
        ]
      }
    }
  },
  "expectedPath": "platform.on[\"test.tick\"][0].name",
  "expectedMessage": "Route placeholder outside a screen"
}
