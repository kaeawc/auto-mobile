{
  "spec": {
    "id": "routes-integration",
    "data": {
      "items": []
    },
    "state": {
      "input": "",
      "open": true
    },
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "home",
      "screens": {
        "home": {
          "type": "text",
          "text": "Home"
        },
        "detail": {
          "type": "button",
          "label": "Go",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com",
              "append": {
                "from": "/items",
                "to": "/data/items{route.id}"
              }
            }
          ]
        }
      },
      "routes": {
        "detail": {
          "params": {
            "id": "string"
          }
        }
      }
    }
  },
  "expectedPath": "root.screens[\"detail\"].onTap[0].append.to",
  "expectedMessage": "Route placeholder must occupy a whole data pointer segment"
}
