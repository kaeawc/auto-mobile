{
  "spec": {
    "id": "routes-review",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "home",
      "screens": {
        "home": {
          "type": "text",
          "text": "Home"
        },
        "detail": {
          "type": "text",
          "text": "Detail"
        }
      },
      "routes": {
        "detail": {
          "onBack": [
            {
              "type": "request",
              "url": "https://example.com",
              "statusKey": "status",
              "onSuccess": [
                {
                  "type": "pop",
                  "stack": "nav"
                }
              ]
            }
          ]
        }
      }
    },
    "state": {
      "status": "idle"
    }
  },
  "expectedPath": "root.routes.detail.onBack[0].onSuccess[0]",
  "expectedMessage": "Direct onBack pop requires force: true"
}
