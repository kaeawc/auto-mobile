{
  "spec": {
    "id": "routes-review",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "home",
      "screens": {
        "home": {
          "type": "text",
          "text": "Home"
        },
        "detail": {
          "type": "text",
          "text": "x",
          "visibleWhen": {
            "data": "/items/prefix{route.x}",
            "equals": 1
          }
        }
      },
      "routes": {
        "detail": {
          "params": {
            "x": "string"
          }
        }
      }
    }
  },
  "expectedPath": "root.screens[\"detail\"].visibleWhen.data",
  "expectedMessage": "Route placeholder must occupy a whole data pointer segment"
}
