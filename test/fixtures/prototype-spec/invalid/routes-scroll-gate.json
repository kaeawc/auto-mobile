      },
      "routes": {
        "detail": {}
      }
    }
  },
  "options": {
    "supportedCapabilities": ["prototype_chat_scroll_v1", "prototype_stack_v1"]
  },
  "expectedPath": "$",
  "expectedMessage": "Unsupported capabilities: prototype_routes_v1"
