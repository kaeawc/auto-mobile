{
  "spec": {
    "id": "routes",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "home",
      "screens": {
        "home": {
          "type": "button",
          "label": "Open",
          "onTap": [
            {
              "type": "setStack",
              "stack": "nav",
              "path": [
                {
                  "screen": "missing"
                }
              ]
            }
          ]
        },
        "detail": {
          "type": "text",
          "text": "Post {route.postId} ({route.count})"
        }
      },
      "routes": {
        "home": {
          "onEnter": [
            {
              "type": "emit",
              "name": "home"
            }
          ]
        },
        "detail": {
          "params": {
            "postId": "string",
            "count": "number",
            "flag": "boolean"
          },
          "onEnter": [
            {
              "type": "emit",
              "name": "entered"
            }
          ],
          "onBack": [
            {
              "type": "pop",
              "stack": "nav",
              "force": true
            }
          ]
        }
      }
    },
    "storage": {
      "version": 1,
      "keys": ["stack:nav"]
    }
  },
  "expectedPath": "root.screens[\"home\"].onTap[0]",
  "expectedMessage": "Unknown stack screen"
}
