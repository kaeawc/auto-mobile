{
  "spec": {
    "id": "prototype",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "open": true
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "button",
          "id": "target",
          "label": "Help"
        },
        {
          "type": "tooltip",
          "text": "{route.x}",
          "openWhen": {
            "key": "open",
            "equals": true
          },
          "anchorTo": "target",
          "testTag": "help",
          "caret": "top",
          "spotlight": {
            "padding": 8,
            "cornerRadius": 12
          },
          "onDismiss": [
            {
              "type": "emit",
              "name": "closed"
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.children[1].text",
  "expectedMessage": "Route placeholder outside a screen"
}
