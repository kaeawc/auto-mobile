{
  "spec": {
    "id": "scroll-motion",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "motion": "none",
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "one",
      "screens": {
        "one": {
          "type": "scroll",
          "id": "feed",
          "style": {
            "height": {
              "dp": 200
            }
          },
          "child": {
            "type": "column",
            "children": [
              {
                "type": "text",
                "text": "Hero",
                "scrollLinked": {
                  "source": "feed",
                  "range": [0, 160],
                  "alpha": [1, 0],
                  "offsetY": [0, -40],
                  "offsetX": [0, 20],
                  "scale": [1, 0.8],
                  "blur": [0, 8]
                },
                "scrollTransition": {
                  "axis": "vertical",
                  "edge": {
                    "alpha": 0.5,
                    "scale": 0.88,
                    "rotation": 8
                  }
                }
              },
              {
                "type": "spacer",
                "style": {
                  "height": {
                    "dp": 1000
                  }
                }
              }
            ]
          }
        },
        "two": {
          "type": "text",
          "text": "x",
          "scrollLinked": {
            "source": "feed",
            "range": [0, 160],
            "alpha": [1, 0],
            "offsetY": [0, -40],
            "offsetX": [0, 20],
            "scale": [1, 0.8],
            "blur": [0, 8]
          }
        }
      }
    }
  },
  "expectedPath": "root.screens[\"two\"].scrollLinked.source",
  "expectedMessage": "Expected a scroll id in the same screen"
}
