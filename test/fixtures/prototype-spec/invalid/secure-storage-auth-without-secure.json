{
  "spec": {
    "id": "secure-storage-auth-without-secure",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "token": "",
      "remember": false
    },
    "requires": {
      "platform": ["secureStorage", "biometric"]
    },
    "storage": {
      "version": 1,
      "keys": ["state:remember"],
      "secureAuth": {
        "state:token": "biometric"
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "token"
        },
        {
          "type": "button",
          "label": "Save",
          "onTap": [
            {
              "type": "emit",
              "name": "save",
              "context": {
                "r": {
                  "state": "remember"
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "Locked",
          "visibleWhen": {
            "platform": "/secureStorage/locked",
            "equals": true
          }
        }
      ]
    }
  },
  "expectedPath": "storage.secureAuth[\"state:token\"]"
}
