{
  "spec": {
    "id": "secure-storage-request-follow-up",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "token": "",
      "remember": false
    },
    "requires": {
      "platform": ["secureStorage", "biometric"]
    },
    "storage": {
      "version": 1,
      "keys": ["state:remember"],
      "secure": ["state:token"],
      "secureAuth": {
        "state:token": "biometric"
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "token"
        },
        {
          "type": "button",
          "label": "Save",
          "onTap": [
            {
              "type": "emit",
              "name": "save",
              "context": {
                "r": {
                  "state": "remember"
                }
              }
            },
            {
              "type": "request",
              "url": "https://example.com/session",
              "via": "device",
              "onError": [
                {
                  "type": "request",
                  "url": "https://example.com/session",
                  "via": "device",
                  "headers": {
                    "X-Retry": {
                      "state": "token"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "text": "Locked",
          "visibleWhen": {
            "platform": "/secureStorage/locked",
            "equals": true
          }
        }
      ]
    }
  },
  "expectedPath": "root.children[1].onTap[1].onError[0].headers[\"X-Retry\"]",
  "expectedMessage": "Secure storage key state:token cannot be sent in a request without allowSecureInRequest"
}
