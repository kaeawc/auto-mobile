{
  "spec": {
    "id": "secure-storage-request-repeat-text",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "token": "",
      "remember": false
    },
    "requires": {
      "platform": ["secureStorage", "biometric"]
    },
    "storage": {
      "version": 1,
      "keys": ["state:remember"],
      "secure": ["state:token"],
      "secureAuth": {
        "state:token": "biometric"
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "token"
        },
        {
          "type": "column",
          "repeat": {
            "as": "row",
            "items": [
              {
                "id": "en"
              }
            ]
          },
          "children": [
            {
              "type": "button",
              "label": "Save",
              "onTap": [
                {
                  "type": "emit",
                  "name": "save",
                  "context": {
                    "r": {
                      "state": "remember"
                    }
                  }
                },
                {
                  "type": "request",
                  "url": "https://example.com/session",
                  "via": "device",
                  "headers": {
                    "Authorization": "Bearer {tok{row.id}}"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "text": "Locked",
          "visibleWhen": {
            "platform": "/secureStorage/locked",
            "equals": true
          }
        }
      ]
    }
  },
  "expectedPath": "root.children[1].children[0].onTap[1].headers.Authorization",
  "expectedMessage": "Secure storage key state:token cannot be sent in a request without allowSecureInRequest"
}
