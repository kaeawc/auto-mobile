{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "button",
      "label": "Share",
      "onTap": [
        {
          "type": "platform",
          "call": "share.open",
          "args": {
            "contact": {
              "value": 1
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.contact.value",
  "expectedMessage": "Expected share contact object"
}
