{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "button",
      "label": "Share",
      "onTap": [
        {
          "type": "platform",
          "call": "share.open",
          "args": {
            "url": {
              "value": "data:text/plain,hi"
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.url.value",
  "expectedMessage": "Share URL must be absolute http(s) with a literal scheme"
}
