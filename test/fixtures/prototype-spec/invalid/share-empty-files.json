{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "button",
      "label": "Share",
      "onTap": [
        {
          "type": "platform",
          "call": "share.open",
          "args": {
            "files": {
              "value": []
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.files.value",
  "expectedMessage": "Share files must contain 1 to 4 items"
}
