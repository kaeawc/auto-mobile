{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "button",
      "label": "Share",
      "onTap": [
        {
          "type": "platform",
          "call": "share.open",
          "args": {
            "files": {
              "value": [
                {
                  "asset": "a",
                  "name": "a",
                  "mimeType": "text/plain",
                  "z": 0
                }
              ]
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.files.value[0].z",
  "expectedMessage": "Unknown file field"
}
