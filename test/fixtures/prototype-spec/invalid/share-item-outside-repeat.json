{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "button",
      "label": "Share",
      "onTap": [
        {
          "type": "platform",
          "call": "share.open",
          "args": {
            "text": {
              "item": "name"
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.text",
  "expectedMessage": "Emit item/index binding outside a repeat template"
}
