{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "button",
      "label": "Share",
      "onTap": [
        {
          "type": "platform",
          "call": "share.open",
          "args": {
            "subject": {
              "value": "Hi"
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args",
  "expectedMessage": "Share requires text, url, images, files or contact"
}
