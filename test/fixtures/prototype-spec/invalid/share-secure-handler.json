{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share", "notifications"]
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "secret",
          "secure": true
        }
      ]
    },
    "state": {
      "secret": "password"
    },
    "platform": {
      "on": {
        "notifications.opened": [
          {
            "type": "platform",
            "call": "share.open",
            "args": {
              "text": {
                "value": "{secret}"
              }
            }
          }
        ]
      }
    }
  },
  "expectedPath": "platform.on[\"notifications.opened\"][0].args.text.value",
  "expectedMessage": "Secure value cannot be bound into an action payload",
  "options": {
    "library": true
  }
}
