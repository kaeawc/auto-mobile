{
  "spec": {
    "id": "share",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["share"]
    },
    "root": {
      "type": "button",
      "label": "Share",
      "onTap": [
        {
          "type": "platform",
          "call": "share.open",
          "args": {
            "images": {
              "value": ["missing"]
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].args.images.value[0]",
