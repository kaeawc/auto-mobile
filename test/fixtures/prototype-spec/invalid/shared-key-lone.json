{
  "spec": {
    "id": "shared",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "open": true
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "Hero",
          "sharedKey": "hero",
          "visibleWhen": {
            "key": "open",
            "equals": true
          }
        }
      ]
    }
  },
  "expectedPath": "root.children[0].sharedKey",
  "expectedMessage": "sharedKey \"hero\" must be used by exactly two nodes"
}
