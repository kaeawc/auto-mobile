{
  "spec": {
    "id": "shared",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "open": true
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "Hero",
          "visibleWhen": {
            "key": "open",
            "equals": true
          },
          "shared": {
            "key": "story-{item.id}",
            "as": "element"
          }
        },
        {
          "type": "text",
          "text": "Hero",
          "visibleWhen": {
            "key": "open",
            "equals": false
          },
          "shared": {
            "key": "hero",
            "as": "element"
          }
        }
      ]
    }
  },
  "expectedPath": "root.children[0].shared.key",
  "expectedMessage": "shared key template requires repeat.key"
}
