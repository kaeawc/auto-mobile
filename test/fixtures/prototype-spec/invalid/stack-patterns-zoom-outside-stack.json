{
  "spec": {
    "id": "stack-patterns",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "Outside",
          "sharedKey": "hero"
        },
        {
          "type": "stack",
          "id": "nav",
          "start": "home",
          "transition": "zoom",
          "screens": {
            "home": {
              "type": "text",
              "text": "Home",
              "onTap": [
                {
                  "type": "push",
                  "stack": "nav",
                  "screen": "detail",
                  "source": "hero"
                },
                {
                  "type": "replace",
                  "stack": "nav",
                  "screen": "detail",
                  "transition": "zoom",
                  "source": "hero"
                }
              ]
            },
            "detail": {
              "type": "text",
              "text": "Detail",
              "onTap": [
                {
                  "type": "pop",
                  "stack": "nav"
                },
                {
                  "type": "popToRoot",
                  "stack": "nav"
                }
              ]
            }
          }
        }
      ]
    }
  },
  "expectedPath": "root.children[1].screens[\"home\"].onTap[0].source",
  "expectedMessage": "zoom source must be inside the target stack's screens"
}
