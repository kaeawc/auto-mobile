{
  "spec": {
    "id": "chat-scroll",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "data": {
      "messages": [
        {
          "id": "m1",
          "text": "Hi"
        },
        {
          "id": "m2",
          "text": "Hello"
        }
      ]
    },
    "state": {
      "atEnd": true,
      "draft": ""
    },
    "root": {
      "type": "column",
      "children": [
        {
          "id": "chat",
          "type": "scroll",
          "axis": "vertical",
          "reverse": true,
          "stickToEnd": true,
          "atEndKey": "atEnd",
          "onStartReached": [
            {
              "type": "emit",
              "name": "load_older"
            }
          ],
          "child": {
            "repeat": {
              "items": {
                "path": "/messages"
              },
              "as": "msg",
              "key": "id"
            },
            "type": "column",
            "children": [
              {
                "type": "text",
                "text": "{msg.text}"
              }
            ]
          }
        },
        {
          "onTap": [
            {
              "type": "scrollTo",
              "scroll": "chat",
              "to": "end",
              "animated": true
            }
          ],
          "visibleWhen": {
            "key": "atEnd",
            "equals": false
          },
          "type": "button",
          "label": "New messages"
        },
        {
          "safeAreaPadding": {
            "edges": ["bottom"],
            "types": ["ime", "ime", "ime", "ime"]
          },
          "type": "row",
          "children": [
            {
              "type": "textField",
              "stateKey": "draft",
              "imeAction": "send",
              "onSubmit": [
                {
                  "type": "appendData",
                  "path": "/data/messages",
                  "value": {
                    "value": {
                      "id": "m3",
                      "text": "Sent"
                    }
                  }
                },
                {
                  "type": "scrollTo",
                  "scroll": "chat",
                  "to": {
                    "key": "m3"
                  }
                }
              ]
            },
            {
              "onTap": [
                {
                  "type": "scrollTo",
                  "scroll": "chat",
                  "to": "start",
                  "animated": false
                }
              ],
              "type": "iconButton",
              "icon": "send"
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.children[2].safeAreaPadding.types"
}
