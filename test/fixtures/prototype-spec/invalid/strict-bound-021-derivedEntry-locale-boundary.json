{
  "spec": {
    "id": "formats",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "data": {
      "price": 1234.5
    },
    "state": {
      "ratio": 0.256
    },
    "derive": {
      "price": {
        "of": {
          "data": "/price"
        },
        "format": {
          "currency": {
            "code": "USD"
          }
        }
      },
      "percent": {
        "of": {
          "state": "ratio"
        },
        "format": {
          "percent": {
            "maxFraction": 1
          }
        }
      },
      "date": {
        "of": {
          "value": "2026-01-05"
        },
        "format": {
          "date": {}
        },
        "locale": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "timeZone": "UTC"
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "{derived:price} {derived:percent} {derived:date}"
        },
        {
          "repeat": {
            "items": [
              {
                "createdAt": "2026-01-05"
              }
            ],
            "as": "item",
            "derive": {
              "createdAtText": {
                "of": {
                  "item": "createdAt"
                },
                "format": {
                  "date": {}
                }
              }
            }
          },
          "type": "column",
          "children": [
            {
              "type": "text",
              "text": "{item.createdAtText}"
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "derive.date.locale"
}
