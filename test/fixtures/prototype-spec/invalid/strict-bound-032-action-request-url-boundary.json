{
  "spec": {
    "id": "request-actions",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "data": {
      "title": "Feed"
    },
    "state": {
      "query": "cats",
      "draft": "hello",
      "feedStatus": "idle",
      "postStatus": "idle",
      "loaded": false
    },
    "root": {
      "type": "column",
      "children": [
        {
          "visibleWhen": {
            "key": "feedStatus",
            "equals": "loading"
          },
          "type": "text",
          "text": "Loading"
        },
        {
          "visibleWhen": {
            "key": "feedStatus",
            "equals": "error"
          },
          "type": "text",
          "text": "Could not load the feed"
        },
        {
          "onTap": [
            {
              "type": "request",
              "method": "GET",
              "url": "",
              "headers": {
                "Accept": "application/json",
                "X-Title": {
                  "data": "/title"
                }
              },
              "query": {
                "q": {
                  "state": "query"
                },
                "limit": {
                  "value": "20"
                }
              },
              "into": "/data/feed",
              "statusKey": "feedStatus",
              "via": "host",
              "timeoutMs": 5000,
              "onSuccess": [
                {
                  "type": "setState",
                  "key": "loaded",
                  "value": true
                },
                {
                  "type": "request",
                  "method": "POST",
                  "url": "https://example.com/seen",
                  "body": {
                    "value": {
                      "seen": true
                    }
                  }
                }
              ],
              "onError": [
                {
                  "type": "emit",
                  "name": "feed_failed"
                }
              ]
            }
          ],
          "type": "button",
          "label": "Load feed"
        },
        {
          "onTap": [
            {
              "type": "request",
              "method": "POST",
              "url": "http://localhost:8080/items/{postStatus}",
              "body": {
                "state": "draft"
              },
              "into": "/data/created",
              "statusKey": "postStatus",
              "via": "device",
              "onError": [
                {
                  "type": "setState",
                  "key": "loaded",
                  "value": false
                }
              ]
            }
          ],
          "type": "button",
          "label": "Send draft"
        }
      ]
    }
  },
  "expectedPath": "root.children[2].onTap[0].url"
}
