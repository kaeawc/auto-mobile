{
  "spec": {
    "id": "template-settings",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "state": {
      "notifications": true,
      "darkMode": false,
      "sync": "wifi",
      "volume": 60,
      "resetOpen": false,
      "saved": false
    },
    "storage": {
      "version": 1,
      "keys": [
        "state:notifications",
        "state:notifications",
        "state:notifications",
        "state:notifications",
        "state:notifications",
        "state:notifications",
        "state:notifications",
