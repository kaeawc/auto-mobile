{
  "spec": {
    "id": "strict",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "lens": "back",
      "flash": "auto",
      "zoom": 0.5
    },
    "requires": {
      "platform": ["camera"],
      "permissions": [
        {
          "name": "camera",
          "purpose": "Show the viewfinder"
        }
      ]
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "cameraPreview",
          "id": "vf",
          "lensKey": "lens",
          "flashKey": "flash",
          "zoomKey": "zoom",
          "aspectRatio": "16:9",
          "contentScale": "fit",
          "mode": "video"
        },
        {
          "type": "button",
          "label": "Flip",
          "onTap": [
            {
              "type": "setState",
              "key": "lens",
              "value": "front"
            }
          ]
        }
      ]
    }
  },
  "options": {
    "supportedCapabilities": ["prototype_platform_v1", "prototype_data_model_v1"]
  },
  "expectedPath": "$",
  "expectedMessage": "Unsupported capabilities: prototype_platform_camera_v1"
}
