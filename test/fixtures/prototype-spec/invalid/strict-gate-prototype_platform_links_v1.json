{
  "spec": {
    "id": "strict",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["links"]
    },
    "root": {
      "type": "button",
      "label": "Open",
      "onTap": [
        {
          "type": "platform",
          "call": "links.open",
          "args": {
            "url": {
              "value": "https://example.com/terms"
            },
            "mode": {
              "value": "inApp"
            }
          }
        }
      ]
    }
  },
  "options": {
    "supportedCapabilities": ["prototype_platform_v1"]
  },
  "expectedPath": "$",
  "expectedMessage": "Unsupported capabilities: prototype_platform_links_v1"
}
