{
  "spec": {
    "id": "strict",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "token": "",
      "remember": false
    },
    "requires": {
      "platform": ["secureStorage", "biometric"]
    },
    "storage": {
      "version": 1,
      "keys": ["state:remember"],
      "secure": ["state:token"],
      "secureAuth": {
        "state:token": "biometric"
      }
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "token"
        },
        {
          "type": "button",
          "label": "Save",
          "onTap": [
            {
              "type": "emit",
              "name": "save",
              "context": {
                "r": {
                  "state": "remember"
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "text": "Locked",
          "visibleWhen": {
            "platform": "/secureStorage/locked",
            "equals": true
          }
        }
      ]
    }
  },
  "options": {
    "supportedCapabilities": [
      "prototype_emit_context_v1",
      "prototype_platform_biometric_v1",
      "prototype_platform_v1",
      "prototype_storage_v1"
    ]
  },
  "expectedPath": "$",
  "expectedMessage": "Unsupported capabilities: prototype_platform_secureStorage_v1"
}
