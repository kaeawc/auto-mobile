{
  "spec": {
    "id": "strict",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["settings"]
    },
    "root": {
      "type": "button",
      "label": "Open settings",
      "onTap": [
        {
          "type": "platform",
          "call": "settings.open",
          "args": {
            "page": {
              "value": "notifications"
            }
          }
        }
      ]
    }
  },
  "options": {
    "supportedCapabilities": ["prototype_platform_v1"]
  },
  "expectedPath": "$",
  "expectedMessage": "Unsupported capabilities: prototype_platform_settings_v1"
}
