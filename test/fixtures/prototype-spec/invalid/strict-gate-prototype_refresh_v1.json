{
  "spec": {
    "id": "feed",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "feed": {
        "items": [
          {
            "id": 1,
            "title": "One"
          },
          {
            "id": 2,
            "title": "Two"
          }
        ]
      },
      "page": {
        "next": "p2"
      }
    },
    "state": {
      "refreshing": false,
      "feedStatus": "idle"
    },
    "root": {
      "type": "list",
      "repeat": {
        "items": {
          "path": "/feed/items"
        },
        "as": "post",
        "key": "id"
      },
      "children": [
        {
          "type": "text",
          "text": "{index}: {post.title}"
        }
      ],
      "id": "feed-list",
      "header": {
        "type": "text",
        "text": "Feed"
      },
      "footer": {
        "type": "text",
        "text": "End"
      },
      "spacing": 8,
      "contentPadding": 12,
      "endThreshold": 2,
      "maxItems": 100,
      "onEndReached": [
        {
          "type": "request",
          "url": "http://localhost:8080/feed?after={data:/page/next}",
          "into": "/data/page",
          "append": {
            "from": "/items",
            "to": "/data/feed/items"
          },
          "statusKey": "feedStatus"
        }
      ],
      "refresh": {
        "stateKey": "refreshing",
        "onRefresh": [
          {
            "type": "request",
            "url": "http://localhost:8080/feed",
            "into": "/data/feed",
            "onSuccess": [
              {
                "type": "setState",
                "key": "refreshing",
                "value": false
              }
            ]
          }
        ]
      }
    }
  },
  "options": {
    "supportedCapabilities": [
      "prototype_data_model_v1",
      "prototype_lazy_list_v1",
      "prototype_network_v1"
    ]
  },
  "expectedPath": "$"
}
