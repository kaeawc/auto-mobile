{
  "spec": {
    "id": "stack-patterns",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "home",
      "transition": "sharedAxisX",
      "screens": {
        "home": {
          "type": "text",
          "text": "Home",
          "onTap": [
            {
              "type": "push",
              "stack": "nav",
              "screen": "detail",
              "transition": "sharedAxisX"
            },
            {
              "type": "push",
              "stack": "nav",
              "screen": "detail",
              "transition": "sharedAxisY"
            },
            {
              "type": "push",
              "stack": "nav",
              "screen": "detail",
              "transition": "fadeThrough"
            },
            {
              "type": "replace",
              "stack": "nav",
              "screen": "detail",
              "transition": "fadeThrough"
            }
          ]
        },
        "detail": {
          "type": "text",
          "text": "Detail"
        }
      }
    }
  },
  "options": {
    "supportedCapabilities": ["prototype_stack_v1", "prototype_stack_transitions_v1"]
  },
  "expectedPath": "$"
}
