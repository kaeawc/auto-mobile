{
  "spec": {
    "id": "stack-patterns",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "stack",
      "id": "nav",
      "start": "home",
      "transition": "zoom",
      "screens": {
        "home": {
          "type": "text",
          "text": "Home",
          "onTap": [
            {
              "type": "push",
              "stack": "nav",
              "screen": "detail",
              "source": "hero"
            },
            {
              "type": "replace",
              "stack": "nav",
              "screen": "detail",
              "transition": "zoom",
              "source": "hero"
            }
          ],
          "sharedKey": "hero"
        },
        "detail": {
          "type": "text",
          "text": "Detail",
          "onTap": [
            {
              "type": "pop",
              "stack": "nav"
            },
            {
              "type": "popToRoot",
              "stack": "nav"
            }
          ]
        }
      }
    }
  },
  "options": {
    "supportedCapabilities": [
      "prototype_stack_v1",
      "prototype_stack_transitions_v1",
      "prototype_shared_element_v1",
      "prototype_zoom_transition_v1"
    ]
  },
  "expectedPath": "$"
}
