{
  "spec": {
    "id": "secure",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "secret": "",
      "password": "",
      "public": "ok"
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "secret",
          "secure": true
        },
        {
          "type": "textField",
          "stateKey": "password",
          "keyboardType": "password"
        },
        {
          "type": "button",
          "label": "Send"
        }
      ]
    },
    "requires": {
      "platform": ["realtime"]
    },
    "channels": {
      "chat": {
        "kind": "websocket",
        "url": "ws://example.com/chat",
        "via": "device",
        "onOpen": [
          {
            "type": "platform",
            "call": "realtime.send",
            "args": {
              "channel": "chat",
              "body": {
                "state": "secret"
              }
            }
          }
        ]
      }
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "channels.chat.onOpen[0].args.body.state",
  "expectedMessage": "Secure value cannot be bound into an action payload"
}
