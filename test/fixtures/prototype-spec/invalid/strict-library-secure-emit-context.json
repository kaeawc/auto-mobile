{
  "spec": {
    "id": "secure",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "secret": "",
      "password": "",
      "public": "ok"
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "secret",
          "secure": true
        },
        {
          "type": "textField",
          "stateKey": "password",
          "keyboardType": "password"
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "emit",
              "name": "send",
              "context": {
                "token": {
                  "state": "password"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "root.children[2].onTap[0].context.token.state"
}
