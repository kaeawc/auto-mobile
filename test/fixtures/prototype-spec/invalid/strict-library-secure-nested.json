{
  "spec": {
    "id": "secure",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "secret": "",
      "password": "",
      "public": "ok"
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "secret",
          "secure": true
        },
        {
          "type": "textField",
          "stateKey": "password",
          "keyboardType": "password"
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com",
              "via": "device",
              "onSuccess": [
                {
                  "type": "request",
                  "url": "https://example.com/{password}",
                  "via": "device"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "root.children[2].onTap[0].onSuccess[0].url",
  "expectedMessage": "Secure value cannot be bound into a request"
}
