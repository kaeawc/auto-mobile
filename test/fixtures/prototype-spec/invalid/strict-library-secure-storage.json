{
  "spec": {
    "id": "secure",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "state": {
      "secret": "",
      "password": "",
      "public": "ok"
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "textField",
          "stateKey": "secret",
          "secure": true
        },
        {
          "type": "textField",
          "stateKey": "password",
          "keyboardType": "password"
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com",
              "via": "device"
            }
          ]
        }
      ]
    },
    "storage": {
      "version": 1,
      "keys": ["state:public", "state:password"]
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "storage.keys[1]",
  "expectedMessage": "Secure value cannot be persisted"
}
