{
  "spec": {
    "id": "data-actions-list",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "data": {
      "title": "List",
      "items": [
        {
          "name": "one"
        },
        {
          "name": "two"
        }
      ]
    },
    "state": {
      "draft": "New item"
    },
    "root": {
      "type": "column",
      "children": [
        {
          "onTap": [
            {
              "type": "appendData",
              "path": "/data/items",
              "value": {
                "value": {
                  "name": "new"
                }
              }
            }
          ],
          "type": "button",
          "label": "Add"
        },
        {
          "onTap": [
            {
              "type": "setData",
              "path": "/data/title",
              "value": {
                "value": "Items"
              },
              "zzzUnknown": true
            }
          ],
          "type": "button",
          "label": "Reset title"
        },
        {
          "repeat": {
            "items": {
              "path": "/items"
            },
            "as": "item"
          },
          "type": "column",
          "children": [
            {
              "type": "text",
              "text": "Row"
            },
            {
              "onTap": [
                {
                  "type": "removeData",
                  "path": "/data/items/{index}"
                }
              ],
              "type": "button",
              "label": "Delete"
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.children[1].onTap[0].zzzUnknown"
}
