{
  "spec": {
    "id": "variants",
    "window": {
      "placement": {
        "type": "fullscreen",
        "scrim": "#80000000"
      },
      "opacity": 80
    },
    "state": {
      "query": "",
      "open": false
    },
    "root": {
      "safeAreaPadding": {
        "edges": ["top", "bottom"],
        "types": ["systemBars", "cutout", "ime"]
      },
      "type": "column",
      "children": [
        {
          "type": "tabBar",
          "items": [
            {
              "label": "Original",
              "icon": "home",
              "zzzUnknown": true
            },
            {
              "label": "Edited",
              "image": "variant-b"
            }
          ],
          "pager": "pages"
        },
        {
          "id": "pages",
          "type": "pager",
          "children": [
            {
              "type": "scroll",
              "axis": "vertical",
              "child": {
                "type": "text",
                "text": "Page {page} of {pageCount}"
              }
            },
            {
              "type": "image",
              "asset": "variant-b",
              "contentScale": "fit"
            }
          ]
        },
        {
          "type": "textField",
          "stateKey": "query",
          "placeholder": "Feedback"
        },
        {
          "onTap": [
            {
              "type": "setPage",
              "pager": "pages",
              "page": "next"
            }
          ],
          "type": "text",
          "text": "Next"
        },
        {
          "type": "bottomSheet",
          "openWhen": {
            "key": "open",
            "equals": true
          },
          "detents": ["half", "full"],
          "child": {
            "type": "text",
            "text": "Details"
          }
        }
      ]
    }
  },
  "expectedPath": "root.children[0].items[0].zzzUnknown"
}
