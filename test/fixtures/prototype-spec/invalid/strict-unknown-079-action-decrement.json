{
  "spec": {
    "id": "prototype",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "state": {
      "selected": "a",
      "last": 0,
      "count": 3
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "Pick one"
        },
        {
          "style": {
            "spacing": 4
          },
          "repeat": {
            "items": [
              {
                "id": "a",
                "label": "Alpha",
                "price": 3,
                "on": true
              },
              {
                "id": "b",
                "label": "Beta",
                "price": 4.5,
                "on": false
              }
            ],
            "as": "item"
          },
          "type": "column",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "styleWhen": [
                    {
                      "when": {
                        "all": [
                          {
                            "key": "selected",
                            "equals": "{item.id}"
                          },
                          {
                            "not": {
                              "key": "count",
                              "gt": 0
                            }
                          }
                        ]
                      },
                      "style": {
                        "background": "#2255CC"
                      }
                    }
                  ],
                  "visibleWhen": {
                    "key": "selected",
                    "notEquals": "{item.id}"
                  },
                  "type": "text",
                  "text": "{index}: {item.label} costs {item.price} ({other.label}) {item.on}"
                },
                {
                  "onTap": [
                    {
                      "type": "setState",
                      "key": "selected",
                      "value": "{item.id}"
                    },
                    {
                      "type": "setState",
                      "key": "last",
                      "value": "{index}"
                    },
                    {
                      "type": "emit",
                      "name": "pick_{item.id}",
                      "payload": {
                        "id": "{item.id}"
                      }
                    }
                  ],
                  "onLongPress": [
                    {
                      "type": "setState",
                      "key": "selected",
                      "value": "{item.id}"
                    },
                    {
                      "type": "setState",
                      "key": "last",
                      "value": "{index}"
                    },
                    {
                      "type": "emit",
                      "name": "pick_{item.id}",
                      "payload": {
                        "id": "{item.id}"
                      }
                    }
                  ],
                  "type": "text",
                  "text": "tap"
                }
              ]
            }
          ]
        },
        {
          "onTap": [
            {
              "type": "decrement",
              "key": "count",
              "zzzUnknown": true
            },
            {
              "type": "decrement",
              "key": "count",
              "by": 2
            }
          ],
          "type": "box",
          "children": [
            {
              "type": "text",
              "text": "-"
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.children[2].onTap[0].zzzUnknown"
}
