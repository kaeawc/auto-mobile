{
  "spec": {
    "id": "alarm",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "state": {
      "editing": false,
      "saved": false,
      "hour": 7,
      "minute": 30,
      "date": "2026-10-08",
      "repeat": "weekdays",
      "upload": 0.4
    },
    "root": {
      "type": "column",
      "children": [
        {
          "testTag": "bar",
          "type": "topAppBar",
          "title": "Alarms",
          "variant": "centerAligned",
          "navigationIcon": {
            "icon": "menu",
            "label": "Menu"
          },
          "actions": [
            {
              "icon": "settings",
              "label": "Settings",
              "onTap": [
                {
                  "type": "emit",
                  "name": "settings"
                }
              ]
            }
          ]
        },
        {
          "testTag": "repeat",
          "type": "segmentedButton",
          "stateKey": "repeat",
          "options": [
            {
              "value": "once",
              "label": "Once"
            },
            {
              "value": "weekdays",
              "label": "Weekdays"
            },
            {
              "value": "daily",
              "label": "Daily"
            }
          ]
        },
        {
          "type": "divider"
        },
        {
          "type": "progress",
          "stateKey": "upload",
          "zzzUnknown": true
        },
        {
          "type": "progress",
          "variant": "circular"
        },
        {
          "type": "badge",
          "text": "3"
        },
        {
          "type": "chip",
          "label": "Snooze",
          "variant": "suggestion"
        },
        {
          "type": "chip",
          "label": "Work",
          "variant": "input"
        },
        {
          "contentDescription": "Delete alarm",
          "type": "iconButton",
          "icon": "delete",
          "variant": "tonal"
        },
        {
          "onTap": [
            {
              "type": "setState",
              "key": "editing",
              "value": true
            }
          ],
          "type": "fab",
          "icon": "add",
          "label": "New alarm"
        },
        {
          "type": "fab",
          "icon": "edit",
          "size": "small"
        },
        {
          "testTag": "edit",
          "type": "dialog",
          "openWhen": {
            "key": "editing",
            "equals": true
          },
          "title": "Edit alarm",
          "text": "Set the time and date.",
          "icon": "alarm",
          "confirm": {
            "label": "Save",
            "onTap": [
              {
                "type": "setState",
                "key": "saved",
                "value": true
              }
            ]
          },
          "dismiss": {
            "label": "Cancel"
          },
          "child": {
            "type": "column",
            "children": [
              {
                "type": "timePicker",
                "hourKey": "hour",
                "minuteKey": "minute",
                "is24Hour": true
              },
              {
                "type": "datePicker",
                "stateKey": "date"
              }
            ]
          }
        },
        {
          "type": "snackbar",
          "openWhen": {
            "key": "saved",
            "equals": true
          },
          "text": "Alarm set for {hour}:{minute}",
          "action": {
            "label": "Undo",
            "onTap": [
              {
                "type": "emit",
                "name": "undo"
              }
            ]
          },
          "durationMs": 4000
        }
      ]
    }
  },
  "expectedPath": "root.children[3].zzzUnknown"
}
