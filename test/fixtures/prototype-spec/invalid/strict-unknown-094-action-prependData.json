{
  "spec": {
    "id": "prepend",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "data": {
      "rows": [
        {
          "id": 1
        }
      ]
    },
    "root": {
      "type": "list",
      "axis": "vertical",
      "repeat": {
        "items": {
          "path": "/rows"
        },
        "as": "row",
        "key": "id"
      },
      "children": [
        {
          "onTap": [
            {
              "type": "prependData",
              "path": "/data/rows",
              "value": {
                "item": "id"
              },
              "zzzUnknown": true
            }
          ],
          "type": "text",
          "text": "{row.id}"
        }
      ]
    }
  },
  "expectedPath": "root.children[0].onTap[0].zzzUnknown"
}
