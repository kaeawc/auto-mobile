{
  "spec": {
    "id": "flow-grid",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "root": {
      "repeat": {
        "items": [
          {
            "name": "One"
          },
          {
            "name": "Two"
          }
        ],
        "as": "item"
      },
      "type": "grid",
      "columns": {
        "minWidth": 100,
        "zzzUnknown": true
      },
      "children": [
        {
          "span": 12,
          "type": "text",
          "text": "{item.name}"
        }
      ]
    }
  },
  "expectedPath": "root.columns.zzzUnknown"
}
