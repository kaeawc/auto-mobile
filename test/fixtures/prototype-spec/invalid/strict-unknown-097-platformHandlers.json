{
  "spec": {
    "id": "platform-handler",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "data": {
      "lastTick": {}
    },
    "state": {
      "ticks": 0
    },
    "requires": {
      "platform": ["test"]
    },
    "platform": {
      "on": {
        "test.tick": [
          {
            "type": "increment",
            "key": "ticks"
          },
          {
            "type": "platform",
            "call": "test.echo",
            "args": {
              "message": {
                "event": "/count"
              }
            },
            "into": "/data/lastTick"
          }
        ]
      },
      "zzzUnknown": true
    },
    "root": {
      "type": "text",
      "text": "Ticks {ticks}"
    }
  },
  "expectedPath": "platform.zzzUnknown"
}
