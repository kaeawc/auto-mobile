{
  "spec": {
    "id": "prototype",
    "window": {
      "placement": {
        "type": "fullscreen"
      },
      "opacity": 100
    },
    "state": {
      "liked_a": false,
      "liked_b": true,
      "notify_a": true,
      "notify_b": false,
      "saved_a": false,
      "saved_b": true,
      "count_a": 0,
      "count_b": 0,
      "open_a": false,
      "open_b": false
    },
    "root": {
      "repeat": {
        "items": [
          {
            "id": "a",
            "name": "Alexey"
          },
          {
            "id": "b",
            "name": "Bea"
          }
        ],
        "as": "item"
      },
      "type": "column",
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "text",
              "text": "{item.name}"
            },
            {
              "testTag": "like",
              "onTap": [
                {
                  "type": "toggle",
                  "key": "liked_{item.id}"
                }
              ],
              "styleWhen": [
                {
                  "when": {
                    "key": "liked_{item.id}",
                    "equals": true
                  },
                  "style": {
                    "color": "#CC2255"
                  }
                }
              ],
              "type": "text",
              "text": "Like"
            },
            {
              "visibleWhen": {
                "any": [
                  {
                    "key": "liked_{item.id}",
                    "equals": true
                  },
                  {
                    "not": {
                      "key": "count_{item.id}",
                      "lt": 1
                    }
                  }
                ]
              },
              "type": "text",
              "text": "Liked"
            },
            {
              "type": "switch",
              "stateKey": "notify_{item.id}"
            },
            {
              "onTap": [
                {
                  "type": "increment",
                  "key": "count_{item.id}"
                },
                {
                  "type": "setState",
                  "key": "last_{index}",
                  "value": "{item.id}"
                }
              ],
              "type": "button",
              "label": "+1"
            },
            {
              "type": "listItem",
              "headline": "Save {item.name}",
              "trailing": {
                "type": "checkbox",
                "stateKey": "saved_{item.id}",
                "zzzUnknown": true
              }
            },
            {
              "type": "dialog",
              "openWhen": {
                "key": "open_{item.id}",
                "equals": true
              },
              "title": "{item.name}",
              "confirm": {
                "label": "Close",
                "onTap": [
                  {
                    "type": "toggle",
                    "key": "open_{item.id}"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  },
  "expectedPath": "root.children[0].children[5].trailing.zzzUnknown"
}
