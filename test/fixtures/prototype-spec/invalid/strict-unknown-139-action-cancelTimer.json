              "child": {
                "style": {
                  "padding": {
                    "top": 16,
                    "bottom": 16,
                    "start": 16,
                    "end": 16
                  },
                  "spacing": 12
                },
                "type": "column",
                "children": [
                  {
                    "testTag": "range_picker",
                    "type": "segmentedButton",
                    "stateKey": "range",
                    "options": [
                      {
                        "value": "week",
                        "label": "Week"
                      },
                      {
                        "value": "month",
                        "label": "Month"
                      }
                    ]
                  },
                  {
                    "testTag": "steps_week",
                    "visibleWhen": {
                      "key": "range",
                      "equals": "week"
                    },
                    "type": "chart",
                    "variant": "line",
                    "series": [
                      {
                        "path": "/week",
                        "x": "day",
                        "y": "y",
                        "label": "Steps",
                        "color": "primary"
                      }
                    ],
                    "xLabels": "all",
                    "goal": 7000
                  },
                  {
                    "testTag": "steps_month",
                    "visibleWhen": {
                      "key": "range",
                      "equals": "month"
                    },
                    "type": "chart",
                    "variant": "bar",
                    "series": [
                      {
                        "path": "/month",
                        "x": "day",
                        "y": "y",
                        "label": "Steps",
                        "color": "primary"
                      }
                    ],
                    "xLabels": "all"
                  },
                  {
                    "testTag": "goal_ring",
                    "type": "chart",
                    "variant": "ring",
                    "series": [
                      {
                        "path": "/today",
                        "y": "y",
                        "label": "Steps today"
                      }
                    ],
                    "goal": 10000
                  },
                  {
                    "testTag": "goal_progress",
                    "type": "progress",
                    "stateKey": "goalProgress"
                  },
                  {
                    "type": "card",
                    "variant": "outlined",
                    "children": [
                      {
                        "style": {
                          "padding": {
                            "top": 16,
                            "bottom": 16,
                            "start": 16,
                            "end": 16
                          },
                          "spacing": 12
                        },
                        "type": "column",
                        "children": [
                          {
                            "style": {
                              "textStyle": "titleMedium"
                            },
                            "type": "text",
                            "text": "Workout timer"
                          },
                          {
                            "testTag": "timer_label",
                            "style": {
                              "textStyle": "headlineSmall"
                            },
                            "type": "text",
                            "text": "{seconds} s elapsed"
                          },
                          {
                            "style": {
                              "spacing": 8
                            },
                            "type": "row",
                            "children": [
                              {
                                "testTag": "timer_start",
                                "onTap": [
                                  {
                                    "type": "setState",
                                    "key": "running",
                                    "value": true
                                  },
                                  {
                                    "type": "startTimer",
                                    "id": "clock",
                                    "afterMs": 1000,
                                    "everyMs": 1000,
                                    "maxRuns": 3600,
                                    "actions": [
                                      {
                                        "type": "increment",
                                        "key": "seconds"
                                      }
                                    ]
                                  }
                                ],
                                "enabledWhen": {
                                  "key": "running",
                                  "equals": false
                                },
                                "type": "button",
                                "label": "Start"
                              },
                              {
                                "testTag": "timer_stop",
                                "onTap": [
                                  {
                                    "type": "setState",
                                    "key": "running",
                                    "value": false
                                  },
                                  {
                                    "type": "cancelTimer",
                                    "id": "clock",
                                    "zzzUnknown": true
                                  }
                                ],
                                "enabledWhen": {
                                  "key": "running",
                                  "equals": true
                                },
                                "type": "button",
                                "label": "Stop",
                                "variant": "outlined"
                              },
                              {
                                "testTag": "timer_reset",
                                "onTap": [
                                  {
                                    "type": "setState",
                                    "key": "seconds",
                                    "value": 0
                                  }
                                ],
                                "type": "button",
                                "label": "Reset",
                                "variant": "text"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
