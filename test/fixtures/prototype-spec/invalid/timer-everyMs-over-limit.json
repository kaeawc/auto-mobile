{
  "spec": {
    "id": "timers",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "root": {
      "type": "button",
      "label": "Start",
      "onTap": [
        {
          "type": "startTimer",
          "id": "tick",
          "afterMs": 100,
          "actions": [
            {
              "type": "emit",
              "name": "tick"
            }
          ],
          "everyMs": 3600001
        }
      ]
    }
  },
  "expectedPath": "root.onTap[0].everyMs"
}
