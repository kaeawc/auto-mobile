{
  "spec": {
    "id": "sensitive-flow",
    "window": { "placement": { "type": "fullscreen" } },
    "requires": { "platform": ["auth"] },
    "state": { "u": "" },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "button",
          "label": "Copy",
          "onTap": [
            { "type": "setState", "key": "u", "value": { "platform": "/auth/userId" } },
            { "type": "setData", "path": "/data/leak", "value": { "state": "u" } }
          ]
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com/submit",
              "via": "device",
              "query": { "q": { "data": "/leak" } }
            }
          ]
        }
      ]
    }
  },
  "options": { "library": true },
  "expectedPath": "root.children[1].onTap[0].query.q",
  "expectedMessage": "Sensitive value cannot be bound into a request"
}
