{
  "spec": {
    "id": "sensitive-flow",
    "window": { "placement": { "type": "fullscreen" } },
    "requires": { "platform": ["clipboard"] },
    "data": { "rows": [{ "code": "authored", "copy": "" }] },
    "state": { "picked": "" },
    "root": {
      "type": "column",
      "children": [
        { "type": "pasteButton", "into": "/data/rows/0/code" },
        {
          "type": "column",
          "repeat": { "items": { "path": "/rows" }, "as": "row" },
          "children": [
            {
              "type": "button",
              "label": "Pick",
              "onTap": [
                { "type": "setState", "key": "picked", "value": "{row.code}" },
                {
                  "type": "setData",
                  "path": "/data/rows/{index}/copy",
                  "value": { "state": "picked" }
                }
              ]
            }
          ]
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com/submit",
              "via": "device",
              "query": { "q": { "data": "/rows/0/copy" } }
            }
          ]
        }
      ]
    }
  },
  "options": { "library": true },
  "expectedPath": "root.children[2].onTap[0].query.q",
  "expectedMessage": "Sensitive value cannot be bound into a request"
}
