{
  "spec": {
    "id": "canonical-equivalent-copy",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["auth"]
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "button",
          "label": "Unused copy",
          "onTap": [
            {
              "type": "setData",
              "path": "/data/\u00e9",
              "value": {
                "platform": "/auth/userId"
              }
            }
          ]
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "setData",
              "path": "/data/e\u0301",
              "value": {
                "platform": "/auth/userId"
              }
            },
            {
              "type": "request",
              "url": "https://example.com/submit",
              "via": "device",
              "method": "POST",
              "body": {
                "data": "/e\u0301"
              }
            }
          ]
        }
      ]
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "root.children[1].onTap[1].body",
  "expectedMessage": "Sensitive value cannot be bound into a request"
}
