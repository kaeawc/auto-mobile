{
  "spec": {
    "id": "sensitive-flow",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["clipboard", "realtime"]
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "pasteButton",
          "into": "/data/code"
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com/submit",
              "via": "device"
            }
          ]
        }
      ]
    },
    "channels": {
      "updates": {
        "kind": "sse",
        "via": "device",
        "url": "https://example.com/events",
        "headers": {
          "Authorization": {
            "data": "/code"
          }
        }
      }
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "channels.updates.headers.Authorization",
  "expectedMessage": "Sensitive value cannot be bound into a request"
}
