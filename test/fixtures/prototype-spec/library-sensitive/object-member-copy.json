{
  "spec": {
    "id": "object-member-copy",
    "window": { "placement": { "type": "fullscreen" } },
    "requires": { "platform": ["auth"] },
    "state": { "u": "" },
    "data": { "label": "safe", "rows": [] },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "button",
          "label": "Copy",
          "onTap": [
            { "type": "setState", "key": "u", "value": { "platform": "/auth/userId" } },
            {
              "type": "appendData",
              "path": "/data/rows",
              "value": {
                "object": {
                  "owner": { "state": "u" },
                  "label": { "data": "/label" },
                  "done": { "value": false }
                }
              }
            }
          ]
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com/submit",
              "via": "device",
              "query": { "q": { "data": "/rows/0/owner" } }
            }
          ]
        }
      ]
    }
  },
  "options": { "library": true },
  "expectedPath": "root.children[1].onTap[0].query.q",
  "expectedMessage": "Sensitive value cannot be bound into a request"
}
