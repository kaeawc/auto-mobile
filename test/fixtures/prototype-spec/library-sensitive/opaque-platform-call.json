{
  "spec": {
    "id": "sensitive-flow",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["clipboard"]
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "button",
          "label": "Literal",
          "onTap": [
            {
              "type": "emit",
              "name": "literal",
              "payload": {
                "type": "platform",
                "call": "clipboard.paste",
                "into": "/data/code"
              }
            }
          ]
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com/submit",
              "via": "device",
              "query": {
                "code": {
                  "data": "/code"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "options": {
    "library": false
  },
  "sinkOnly": true
}
