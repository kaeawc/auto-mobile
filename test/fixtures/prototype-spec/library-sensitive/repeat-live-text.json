{
  "spec": {
    "id": "sensitive-flow",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["clipboard"]
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "pasteButton",
          "into": "/data/rows/0/code"
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com/submit",
              "via": "device",
              "query": {
                "code": "{row.code}"
              }
            }
          ]
        }
      ],
      "repeat": {
        "items": {
          "path": "/rows"
        },
        "as": "row"
      }
    },
    "data": {
      "rows": []
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "root.children[1].onTap[0].query.code",
  "expectedMessage": "Sensitive value cannot be bound into a request"
}
