{
  "spec": {
    "id": "sensitive-flow",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "requires": {
      "platform": ["clipboard"]
    },
    "root": {
      "type": "column",
      "children": [
        {
          "type": "pasteButton",
          "into": "/data/users/{index}/token"
        },
        {
          "type": "button",
          "label": "Send",
          "onTap": [
            {
              "type": "request",
              "url": "https://example.com/submit",
              "via": "device"
            }
          ]
        }
      ],
      "repeat": {
        "items": [
          {
            "key": "a"
          }
        ],
        "as": "row"
      }
    },
    "storage": {
      "version": 1,
      "keys": ["data:/users/0"]
    }
  },
  "options": {
    "library": true
  },
  "expectedPath": "storage.keys[0]",
  "expectedMessage": "Sensitive value cannot be persisted"
}
