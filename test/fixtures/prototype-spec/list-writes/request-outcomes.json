[
  {
    "name": "paging keeps cursor",
    "before": {
      "items": [1],
      "page": {}
    },
    "into": "/data/page",
    "response": {
      "type": "prototype_response",
      "requestId": "r",
      "ok": true,
      "status": 200,
      "headers": {},
      "body": {
        "items": [2, 3],
        "next": "p3"
      },
      "durationMs": 1
    },
    "append": {
      "from": "/items",
      "to": "/data/items",
      "maxItems": 2
    },
    "expected": {
      "status": "success",
      "data": {
        "items": [2, 3],
        "page": {
          "next": "p3"
        },
        "page__meta": {
          "status": 200,
          "headers": {},
          "durationMs": 1
        }
      },
      "meta": {
        "status": 200,
        "headers": {},
        "durationMs": 1
      },
      "wroteInto": true,
      "appended": 2
    }
  },
  {
    "name": "append without into",
    "before": {
      "items": [1]
    },
    "into": null,
    "response": {
      "type": "prototype_response",
      "requestId": "r",
      "ok": true,
      "status": 200,
      "headers": {},
      "body": {
        "items": [2]
      },
      "durationMs": 1
    },
    "append": {
      "from": "/items",
      "to": "/data/items"
    },
    "expected": {
      "status": "success",
      "data": {
        "items": [1, 2]
      },
      "meta": {
        "status": 200,
        "headers": {},
        "durationMs": 1
      },
      "wroteInto": false,
      "appended": 1
    }
  },
