  {
    "name": "escaped nested object member",
    "before": {
      "items": [1]
    },
    "into": "/data/page",
    "response": {
      "type": "prototype_response",
      "requestId": "r",
      "ok": true,
      "status": 200,
      "headers": {},
      "body": {
        "a/b": {
          "~items": [2],
          "next": "p3"
        }
      },
      "durationMs": 1
    },
    "append": {
      "from": "/a~1b/~0items",
      "to": "/data/items"
    },
    "expected": {
      "status": "success",
      "data": {
        "items": [1, 2],
        "page": {
          "a/b": {
            "next": "p3"
          }
        },
        "page__meta": {
          "status": 200,
          "headers": {},
          "durationMs": 1
        }
      },
      "meta": {
        "status": 200,
        "headers": {},
        "durationMs": 1
      },
      "wroteInto": true,
      "appended": 1
    }
