{
  "spec": {
    "id": "patch-demo",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "count": 1,
      "orders": [
        {
          "id": 1,
          "title": "Tea"
        },
        {
          "id": 2,
          "title": "Coffee"
        }
      ],
      "meta": {
        "a": true,
        "b": false
      },
      "a/b": {
        "c~d": "old"
      }
    },
    "state": {
      "enabled": true,
      "label": "Ready",
      "total": 1
    },
    "root": {
      "type": "column",
      "id": "root",
      "children": [
        {
          "type": "card",
          "id": "card",
          "children": [
            {
              "type": "text",
              "id": "title",
              "text": "Orders"
            }
          ]
        },
        {
          "type": "column",
          "id": "repeater",
          "repeat": {
            "items": {
              "path": "/orders"
            },
            "as": "item"
          },
          "children": [
            {
              "type": "text",
              "id": "row",
              "text": "{item.title}"
            }
          ]
        },
        {
          "type": "switch",
          "id": "toggle",
          "stateKey": "enabled"
        }
      ]
    }
  },
  "ops": [
    {
      "op": "replace",
      "path": "/data/count",
      "value": 2
    },
    {
      "op": "add",
      "path": "/data/orders/-",
      "value": {
        "id": 3,
        "title": "Water"
      }
    },
    {
      "op": "test",
      "path": "/state/total",
      "value": 1
    },
    {
      "op": "replace",
      "path": "/state/total",
      "value": 2
    },
    {
      "op": "replaceNode",
      "id": "title",
      "node": {
        "type": "text",
        "id": "title",
        "text": "Three orders"
      }
    }
  ],
  "expected": {
    "id": "patch-demo",
    "window": {
      "placement": {
        "type": "fullscreen"
      }
    },
    "data": {
      "count": 2,
      "orders": [
        {
          "id": 1,
          "title": "Tea"
        },
        {
          "id": 2,
          "title": "Coffee"
        },
        {
          "id": 3,
          "title": "Water"
        }
      ],
      "meta": {
        "a": true,
        "b": false
      },
      "a/b": {
        "c~d": "old"
      }
    },
    "state": {
      "enabled": true,
      "label": "Ready",
      "total": 2
    },
    "root": {
      "type": "column",
      "id": "root",
      "children": [
        {
          "type": "card",
          "id": "card",
          "children": [
            {
              "type": "text",
              "id": "title",
              "text": "Three orders"
            }
          ]
        },
        {
          "type": "column",
          "id": "repeater",
          "repeat": {
            "items": {
              "path": "/orders"
            },
            "as": "item"
          },
          "children": [
            {
              "type": "text",
              "id": "row",
              "text": "{item.title}"
            }
          ]
        },
        {
          "type": "switch",
          "id": "toggle",
          "stateKey": "enabled"
        }
      ]
    }
  }
