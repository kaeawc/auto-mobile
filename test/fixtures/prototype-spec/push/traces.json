  {
    "name": "an unhandled push with a notification changes no data",
    "spec": {
      "id": "np-alert",
      "window": {
        "placement": {
          "type": "fullscreen"
        }
      },
      "data": {
        "messages": []
      },
      "requires": {
        "platform": ["notifications"],
        "permissions": [
          {
            "name": "notifications",
            "purpose": "Tell you about new messages"
          }
        ]
      },
      "notifications": {
        "channels": [
          {
            "id": "chat",
            "name": "Chat",
            "importance": "high"
          }
        ]
      },
      "root": {
        "type": "text",
        "text": "Messages"
      },
      "state": {
        "lastSender": ""
      }
    },
    "steps": [
      {
        "push": {
          "type": "message",
          "data": {
            "id": "m2"
          },
          "notification": {
            "title": "Ada",
            "body": "Hi",
            "channel": "chat"
          }
        },
        "expect": {
          "data": {
            "messages": []
          },
          "state": {
            "lastSender": ""
          },
          "events": [
            {
              "kind": "emit",
              "name": "prototype_platform_event",
              "payload": {
                "event": "notifications.push",
                "data": {
                  "type": "message",
                  "delivery": "foreground",
                  "handled": false
                },
                "simulated": true
              }
            }
          ]
        }
      }
    ]
  }
