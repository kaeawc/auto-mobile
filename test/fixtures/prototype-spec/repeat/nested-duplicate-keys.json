  {
    "name": "eager nested repeat rejects a constant derived inner key",
    "spec": {
      "id": "nested",
      "window": {
        "placement": {
          "type": "fullscreen"
        }
      },
      "root": {
        "type": "column",
        "repeat": {
          "items": {
            "path": "/orders"
          },
          "as": "order",
          "key": "id"
        },
        "children": [
          {
            "type": "column",
            "repeat": {
              "items": {
                "field": "lines"
              },
              "as": "line",
              "key": "shown",
              "derive": {
                "shown": {
                  "of": {
                    "value": 1
                  },
                  "format": {
                    "number": {}
                  }
                }
              }
            },
            "children": [
              {
                "type": "text",
                "text": "{line.sku} {line.shown}"
              }
            ]
          }
        ]
      },
      "data": {
        "orders": [
          {
            "id": "A",
            "lines": [
              {
                "sku": "PEN"
              }
            ]
          },
          {
            "id": "B",
            "lines": []
          },
          {
            "id": "C",
            "lines": [
              {
                "sku": "PAD"
              },
              {
                "sku": "INK"
              }
            ]
          }
        ]
      }
    },
    "error": {
      "path": "root.children[0].repeat.key",
      "message": "Derived repeat key \"shown\" has the same input for items 0 and 1"
    }
  },
