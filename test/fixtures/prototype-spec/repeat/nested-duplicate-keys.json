[
  {
    "name": "eager nested repeat rejects a duplicate literal inner key",
    "spec": {
      "id": "nested",
      "window": {
        "placement": {
          "type": "fullscreen"
        }
      },
      "root": {
        "type": "column",
        "repeat": {
          "items": {
            "path": "/orders"
          },
          "as": "order",
          "key": "id"
        },
        "children": [
          {
            "type": "column",
            "repeat": {
              "items": {
                "field": "lines"
              },
              "as": "line",
              "key": "sku"
            },
            "children": [
              {
                "type": "text",
                "text": "{line.sku}"
              }
            ]
          }
        ]
      },
      "data": {
        "orders": [
          {
            "id": "A",
            "lines": [
              {
                "sku": "PEN"
              },
              {
                "sku": "PEN"
              }
            ]
          }
        ]
      }
    },
    "error": {
      "path": "root.children[0].repeat.key",
      "message": "Duplicate repeat key \"PEN\" (items 0 and 1)"
    }
  },
