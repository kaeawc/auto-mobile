{
  "id": "nested",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "root": {
    "type": "column",
    "repeat": {
      "items": {
        "path": "/orders"
      },
      "as": "order"
    },
    "children": [
      {
        "type": "card",
        "children": [
          {
            "type": "text",
            "text": "Order {order.id} #{index} {order.customer}"
          },
          {
            "type": "column",
            "repeat": {
              "items": {
                "field": "lines"
              },
              "as": "line"
            },
            "children": [
              {
                "type": "text",
                "text": "{line.sku} x{line.qty} ({order.id} {outerIndex}.{index})"
              }
            ]
          }
        ]
      }
    ]
  },
  "data": {
    "orders": [
      {
        "id": "A",
        "customer": "Ada",
        "lines": [
          {
            "sku": "PEN",
            "qty": 2,
            "price": 3
          },
          {
            "sku": "INK",
            "qty": 1,
            "price": 5
          }
        ]
      },
      {
        "id": "C",
        "customer": "Cy",
        "lines": [
          {
            "sku": "PAD",
            "qty": 3,
            "price": 4
          }
        ]
      }
    ]
  }
}
