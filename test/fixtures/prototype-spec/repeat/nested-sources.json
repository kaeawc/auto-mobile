[
  {
    "name": "empty outer data array draws no inner rows",
    "spec": {
      "id": "nested",
      "window": {
        "placement": {
          "type": "fullscreen"
        }
      },
      "root": {
        "type": "column",
        "repeat": {
          "items": {
            "path": "/orders"
          },
          "as": "order"
        },
        "children": [
          {
            "type": "column",
            "repeat": {
              "items": {
                "field": "lines"
              },
              "as": "line"
            },
            "children": [
              {
                "type": "text",
                "text": "{outerIndex}/{index} {order.id} {order.customer}: {line.sku} x{line.qty}"
              }
            ]
          }
        ]
      }
    },
    "data": {
      "orders": []
    },
    "expected": {
      "rows": []
    }
  },
  {
    "name": "empty derived outer collection draws no inner rows",
    "spec": {
      "id": "nested",
      "window": {
        "placement": {
          "type": "fullscreen"
        }
      },
      "root": {
        "type": "column",
        "repeat": {
          "items": {
            "derived": "ordersView"
          },
          "as": "order"
        },
        "children": [
          {
            "type": "column",
            "repeat": {
              "items": {
                "field": "lines"
              },
              "as": "line"
            },
            "children": [
              {
                "type": "text",
                "text": "{outerIndex}/{index} {order.id} {order.customer}: {line.sku} x{line.qty}"
              }
            ]
          }
        ]
      },
      "derive": {
        "ordersView": {
          "collection": {
            "of": {
              "data": "/orders"
            },
            "where": [
              {
                "field": "id",
                "op": "eq",
                "value": {
                  "value": "missing"
                }
              }
            ],
            "sort": {
              "field": "id",
              "order": "desc"
            }
          }
        }
      }
    },
    "data": {
      "orders": [
        {
          "id": "A",
          "customer": "Ada",
          "lines": [
            {
              "sku": "PEN",
              "qty": 2,
              "price": 3
            },
            {
              "sku": "INK",
              "qty": 1,
              "price": 5
            }
          ]
        },
        {
          "id": "B",
          "customer": "Bo",
          "lines": []
        },
        {
          "id": "C",
          "customer": "Cy",
          "lines": [
            {
              "sku": "PAD",
              "qty": 3,
              "price": 4
            }
          ]
        }
      ]
    },
    "expected": {
      "rows": []
    }
  }
]
