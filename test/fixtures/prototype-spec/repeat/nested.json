  {
    "name": "both aliases and indices keep row fields distinct",
    "spec": {
      "id": "nested",
      "window": {
        "placement": {
          "type": "fullscreen"
        }
      },
      "root": {
        "type": "column",
        "repeat": {
          "items": {
            "path": "/orders"
          },
          "as": "order"
        },
        "children": [
          {
            "type": "column",
            "repeat": {
              "items": {
                "field": "lines"
              },
              "as": "line"
            },
            "children": [
              {
                "type": "text",
                "text": "{outerIndex}/{index} {order.id} {order.customer}: {line.sku} x{line.qty}"
              },
              {
                "type": "text",
                "text": "row field {line.outerIndex}; outer {outerIndex}; inner {index}"
              }
            ]
          }
        ]
      }
    },
    "data": {
      "orders": [
        {
          "id": "A",
          "customer": "{line.sku}",
          "lines": [
            {
              "sku": "{order.id}",
              "qty": 2,
              "price": 3,
              "outerIndex": 99
            }
          ]
        }
      ]
    },
    "expected": {
      "rows": [
        {
          "outerIndex": 0,
          "innerIndex": 0,
          "texts": ["0/0 A {line.sku}: {order.id} x2", "row field 99; outer 0; inner 0"]
        }
      ]
    }
  }
]
