[
  {
    "name": "data orders with empty inner array",
    "spec": {
      "id": "nested",
      "window": {
        "placement": {
          "type": "fullscreen"
        }
      },
      "root": {
        "type": "column",
        "repeat": {
          "items": {
            "path": "/orders"
          },
          "as": "order"
        },
        "children": [
          {
            "type": "column",
            "repeat": {
              "items": {
                "field": "lines"
              },
              "as": "line"
            },
            "children": [
              {
                "type": "text",
                "text": "{outerIndex}/{index} {order.id} {order.customer}: {line.sku} x{line.qty}"
              }
            ]
          }
        ]
      }
    },
    "data": {
      "orders": [
        {
          "id": "A",
          "customer": "Ada",
          "lines": [
            {
              "sku": "PEN",
              "qty": 2,
              "price": 3
            },
            {
              "sku": "INK",
              "qty": 1,
              "price": 5
            }
          ]
        },
        {
          "id": "B",
          "customer": "Bo",
          "lines": []
        },
        {
          "id": "C",
          "customer": "Cy",
          "lines": [
            {
              "sku": "PAD",
              "qty": 3,
              "price": 4
            }
          ]
        }
      ]
    },
    "expected": {
      "rows": [
        {
          "outerIndex": 0,
          "innerIndex": 0,
          "texts": ["0/0 A Ada: PEN x2"]
        },
        {
          "outerIndex": 0,
          "innerIndex": 1,
          "texts": ["0/1 A Ada: INK x1"]
        },
        {
          "outerIndex": 2,
          "innerIndex": 0,
          "texts": ["2/0 C Cy: PAD x3"]
        }
      ]
    }
  },
