            "children": [
              {
                "type": "text",
                "text": "{outerIndex}/{index} {order.id} {order.customer}: {line.sku} x{line.qty}"
              }
            ]
          }
        ]
      },
      "derive": {
        "orders": {
          "collection": {
            "of": {
              "data": "/orders"
            }
          }
        }
      }
    },
    "data": {
      "orders": [
        {
          "id": "A",
          "customer": "Ada",
          "lines": [
