{
  "id": "clipboard",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "requires": {
    "platform": ["clipboard"]
  },
  "root": {
    "type": "button",
    "label": "Clipboard",
    "onTap": [
      {
        "type": "platform",
        "call": "clipboard.copy",
        "args": {
          "text": {
            "value": "private"
          },
          "sensitive": {
            "value": true
          },
          "label": {
            "value": "Secret"
          }
        }
      }
    ]
  }
}
