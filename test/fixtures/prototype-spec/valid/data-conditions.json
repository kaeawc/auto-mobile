            {
              "data": "/n",
              "equals": 1
            },
            {
              "any": [
                {
                  "data": "/n",
                  "notEquals": 0
                },
                {
                  "not": {
                    "data": "/n",
                    "lt": 0
                  }
                }
              ]
            },
            {
              "data": "/n",
              "gt": 0
            }
          ]
        },
