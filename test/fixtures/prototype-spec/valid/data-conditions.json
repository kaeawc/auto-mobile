{
  "id": "orders",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "root": {
    "type": "text",
    "text": "ok",
    "visibleWhen": {
      "all": [
        {
          "data": "/n",
          "equals": 1
        },
        {
