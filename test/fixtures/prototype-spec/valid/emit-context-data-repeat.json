{
  "id": "emit-context",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "root": {
    "type": "column",
    "repeat": {
      "items": {
        "path": "/rows"
      },
      "as": "item"
    },
    "children": [
      {
        "type": "text",
        "text": "Emit",
        "onTap": [
          {
            "type": "emit",
            "name": "pick",
            "context": {
              "id": {
                "item": "id"
              },
              "row": {
                "index": true
              }
            }
          }
        ]
      }
    ]
  },
  "data": {
    "rows": [
      {
        "id": 1
      },
      {
        "id": 2
      },
      {
        "id": 3
      }
    ]
  }
}
