{
  "id": "emit-context",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "root": {
    "type": "text",
    "text": "Emit",
    "onTap": [
      {
        "type": "emit",
        "name": "pick",
        "context": {
          "id": {
            "value": 7
          }
        },
        "payload": {
          "literal": "{item.id}"
        }
      }
    ]
  }
}
