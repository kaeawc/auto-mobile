{
  "id": "glass",
  "state": {
    "on": true,
    "t": "a"
  },
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "root": {
    "type": "row",
    "ios": {
      "glassGroup": {
        "spacing": 8
      }
    },
    "children": [
      {
        "type": "row",
        "repeat": {
          "items": [
            {
              "id": "x"
            },
            {
              "id": "y"
            }
          ],
          "key": "id",
          "as": "item"
        },
        "style": {
          "surface": "glass"
        },
        "shared": {
          "key": "g-{item.id}",
          "as": "bounds"
        },
        "children": []
      }
    ]
  }
}
