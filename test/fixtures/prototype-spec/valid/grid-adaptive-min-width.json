{
  "id": "flow-grid",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "root": {
    "type": "grid",
    "columns": {
      "minWidth": 100
    },
    "repeat": {
      "items": [
        {
          "name": "One"
        },
        {
          "name": "Two"
        }
      ],
      "as": "item"
    },
    "children": [
      {
        "type": "text",
        "text": "{item.name}",
        "span": 12
      }
    ]
  }
}
