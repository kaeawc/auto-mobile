{
  "id": "hide-keyboard",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "state": {
    "draft": ""
  },
  "root": {
    "type": "column",
    "children": [
      {
        "type": "textField",
        "stateKey": "draft"
      },
      {
        "type": "button",
        "label": "Done",
        "onTap": [
          {
            "type": "hideKeyboard"
          },
          {
            "type": "emit",
            "name": "done"
          }
        ]
      }
    ]
  }
}
