{
  "id": "links-platform",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "data": {
    "here": {}
  },
  "state": {
    "locStatus": "",
    "located": false,
    "fixes": 0
  },
  "requires": {
    "platform": ["location"],
    "permissions": [
      {
        "name": "location",
        "purpose": "Show rides near you"
      }
    ],
    "capabilities": ["prototype_links_v1"]
  },
  "platform": {
    "on": {
      "location.updated": [
        {
          "type": "increment",
          "key": "fixes"
        }
      ]
    }
  },
  "root": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "Fixes {fixes}",
        "visibleWhen": {
          "platform": "/location/servicesEnabled",
          "equals": true
        }
      },
      {
        "type": "button",
        "label": "Find me",
        "onTap": [
          {
            "type": "platform",
            "call": "location.request",
            "args": {
              "accuracy": {
                "value": "precise"
              },
              "maxAgeMs": {
                "value": 60000
              }
            },
            "timeoutMs": 10000,
            "into": "/data/here",
            "statusKey": "locStatus",
            "onSuccess": [
              {
                "type": "setState",
                "key": "located",
                "value": true
              }
            ],
            "onError": [
              {
                "type": "setState",
                "key": "located",
                "value": false
              }
            ]
          }
        ]
      }
    ]
  },
  "links": [
    {
      "path": "/nearby",
      "actions": [
        {
          "type": "setState",
          "key": "located",
          "value": true
        }
      ]
    }
  ]
}
