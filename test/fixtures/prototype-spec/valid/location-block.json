{
  "id": "location-block",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "state": {
    "fixes": 0
  },
  "requires": {
    "platform": ["location"],
    "permissions": [
      {
        "name": "location",
        "purpose": "Show rides near you"
      }
    ]
  },
  "location": {
    "accuracy": "approximate",
    "minIntervalMs": 5000,
    "minDistanceM": 25
  },
  "platform": {
    "on": {
      "location.updated": [
        {
          "type": "increment",
          "key": "fixes"
        }
      ]
    }
  },
  "root": {
    "type": "text",
    "text": "Fixes {fixes}"
  }
}
