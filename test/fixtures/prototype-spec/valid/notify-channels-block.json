          "channel": {
            "value": "messages"
          },
          "title": {
            "value": "Ada"
          }
        }
      },
      {
        "type": "platform",
        "call": "notifications.post",
        "args": {
          "id": {
            "value": "msg-1"
          },
          "channel": {
            "value": "promos"
          },
          "title": {
            "value": "Ada"
          },
          "actions": {
            "value": [
              {
                "id": "open",
                "label": "Open"
              },
              {
                "id": "later",
                "label": "Later"
              }
            ]
          }
        }
      },
      {
        "type": "platform",
        "call": "notifications.cancel",
        "args": {
          "id": {
            "value": "msg-1"
          }
        }
      },
      {
        "type": "platform",
        "call": "notifications.cancel",
        "args": {
