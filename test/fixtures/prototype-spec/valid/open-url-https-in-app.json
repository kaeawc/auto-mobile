{
  "id": "open-url-https-in-app",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "requires": {
    "platform": ["links"]
  },
  "root": {
    "type": "button",
    "label": "Open",
    "onTap": [
      {
        "type": "platform",
        "call": "links.open",
        "args": {
          "url": {
            "value": "https://example.com/terms"
          },
          "mode": {
            "value": "inApp"
          }
        }
      }
    ]
  }
}
