{
  "id": "platform-camera-capture",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "data": {
    "draft": {
      "picked": [],
      "photo": {}
    }
  },
  "state": {
    "pickStatus": ""
  },
  "requires": {
    "platform": ["camera"]
  },
  "root": {
    "type": "button",
    "label": "Go",
    "onTap": [
      {
        "type": "platform",
        "call": "camera.capture",
        "args": {
          "media": {
            "value": "video"
          },
          "maxDurationMs": {
            "value": 15000
          }
        },
        "into": "/data/draft/photo",
        "statusKey": "pickStatus"
      }
    ]
  }
}
