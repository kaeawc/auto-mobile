{
  "id": "platform-commerce",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "data": {
    "purchase": {}
  },
  "state": {
    "buyStatus": "",
    "failed": false,
    "changes": 0
  },
  "requires": {
    "platform": ["commerce"]
  },
  "commerce": {
    "backend": "fake",
    "products": [
      {
        "id": "pro_monthly",
        "title": "Pro",
        "kind": "subscription",
        "price": {
          "amount": "4.99",
          "currency": "USD"
        },
        "period": "P1M",
        "trialPeriod": "P7D"
      },
      {
        "id": "coins_100",
        "title": "100 coins",
        "kind": "consumable",
        "price": {
          "amount": "0.99",
          "currency": "USD"
        }
      },
      {
        "id": "no_ads",
        "title": "Remove ads",
        "kind": "nonConsumable",
        "price": {
          "amount": "2",
          "currency": "EUR"
        }
      }
    ]
  },
  "platform": {
    "on": {
      "commerce.entitlementsChanged": [
        {
          "type": "increment",
          "key": "changes"
        }
      ]
    }
  },
  "root": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "Entitlement changes {changes}"
      },
      {
        "type": "button",
        "label": "Go Pro",
        "onTap": [
          {
            "type": "platform",
            "call": "commerce.purchase",
            "args": {
              "productId": {
                "value": "pro_monthly"
              }
            },
            "into": "/data/purchase",
            "statusKey": "buyStatus",
            "onError": [
              {
                "type": "setState",
                "key": "failed",
                "value": true
              }
            ]
          }
        ]
      },
      {
        "type": "button",
        "label": "Restore",
        "onTap": [
          {
            "type": "platform",
            "call": "commerce.restore",
            "args": {}
          }
        ]
      }
    ]
  }
}
