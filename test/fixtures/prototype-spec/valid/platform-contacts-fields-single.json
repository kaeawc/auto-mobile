{
  "id": "platform-contacts-fields-single",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "data": {
    "recipient": {}
  },
  "state": {
    "pickStatus": ""
  },
  "requires": {
    "platform": ["contacts"]
  },
  "root": {
    "type": "button",
    "label": "Go",
    "onTap": [
      {
        "type": "platform",
        "call": "contacts.pick",
        "args": {
          "fields": {
            "value": ["name"]
          },
          "multiple": {
            "value": false
          }
        },
        "into": "/data/recipient",
        "statusKey": "pickStatus"
      }
    ]
  }
}
