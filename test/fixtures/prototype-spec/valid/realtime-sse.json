{
  "id": "realtime",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "requires": {
    "platform": ["realtime"]
  },
  "state": {
    "chatStatus": "idle",
    "unread": 0,
    "peerTyping": false
  },
  "data": {
    "messages": []
  },
  "channels": {
    "chat": {
      "kind": "sse",
      "url": "https://api.example.com/events/{tripId}",
      "via": "device",
      "connect": "manual",
      "decode": "text",
      "routes": [
        {
          "when": {
            "event": "location"
          },
          "actions": [
            {
              "type": "setData",
              "path": "/data/driver",
              "value": {
                "event": ""
              }
            }
          ]
        }
      ]
    }
  },
  "platform": {
    "on": {
      "realtime.frame": [
        {
          "type": "setData",
          "path": "/data/latest",
          "value": {
            "event": ""
          }
        }
      ],
      "realtime.status": [
        {
          "type": "setState",
          "key": "chatStatus",
          "value": {
            "event": "/status"
          }
        }
      ]
    }
  },
  "root": {
    "type": "text",
    "text": "Chat",
    "visibleWhen": {
      "platform": "/realtime/chat/status",
      "equals": "open"
    },
    "onTap": [
      {
        "type": "platform",
        "call": "realtime.connect",
        "args": {
          "channel": "chat"
        }
      },
      {
        "type": "platform",
        "call": "realtime.disconnect",
        "args": {
          "channel": "chat"
        }
      }
    ]
  }
}
