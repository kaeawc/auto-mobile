{
  "id": "scroll-motion",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "motion": "reduced",
  "root": {
    "type": "scroll",
    "id": "feed",
    "style": {
      "height": {
        "dp": 200
      }
    },
    "child": {
      "type": "column",
      "children": [
        {
          "type": "text",
          "text": "Hero",
          "scrollLinked": {
            "source": "feed",
            "range": [0, 160],
            "alpha": [1, 0],
            "offsetY": [0, -40],
            "offsetX": [0, 20],
            "scale": [1, 0.8],
            "blur": [0, 8]
          },
          "scrollTransition": {
            "axis": "vertical",
            "edge": {
              "alpha": 0.5,
              "scale": 0.88,
              "rotation": 8
            }
          }
        },
        {
          "type": "spacer",
          "style": {
            "height": {
              "dp": 1000
            }
          }
        }
      ]
    }
  }
}
