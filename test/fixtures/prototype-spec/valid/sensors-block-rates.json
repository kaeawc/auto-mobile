{
  "id": "sensors-block-rates",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "state": {
    "shakes": 0
  },
  "requires": {
    "platform": ["sensors"],
    "permissions": [
      {
        "name": "motion",
        "purpose": "Count your steps."
      }
    ]
  },
  "sensors": {
    "shake": {},
    "orientation": {
      "rateHz": 1
    },
    "steps": {},
    "proximity": {},
    "light": {
      "rateHz": 30
    }
  },
  "platform": {
    "on": {
      "sensors.shake": [
        {
          "type": "increment",
          "key": "shakes"
        },
        {
          "type": "emit",
          "name": "shake"
        }
      ]
    }
  },
  "root": {
    "type": "column",
    "children": [
      {
        "type": "text",
        "text": "Shakes {shakes}, heading {platform:/sensors/headingDeg}"
      },
      {
        "type": "text",
        "text": "Steps {platform:/sensors/steps}"
      },
      {
        "type": "text",
        "text": "Too close",
        "visibleWhen": {
          "platform": "/sensors/proximityNear",
          "equals": true
        }
      },
      {
        "type": "text",
        "text": "Dark here",
        "visibleWhen": {
          "platform": "/sensors/lightLux",
          "equals": 0
        }
      }
    ]
  }
}
