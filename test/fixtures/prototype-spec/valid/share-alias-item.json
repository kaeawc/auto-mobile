{
  "id": "share",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "requires": {
    "platform": ["share"]
  },
  "root": {
    "type": "column",
    "repeat": {
      "as": "item",
      "items": [
        {
          "u": "https://example.com",
          "mime": "text/plain",
          "name": "a.txt"
        }
      ]
    },
    "children": [
      {
        "type": "button",
        "label": "Share",
        "onTap": [
          {
            "type": "platform",
            "call": "share.open",
            "args": {
              "url": {
                "value": "https://{item.u}/"
              },
              "files": {
                "value": [
                  {
                    "asset": "file",
                    "name": "{item.name}",
                    "mimeType": "{item.mime}"
                  }
                ]
              }
            }
          }
        ]
      }
    ]
  }
}
