{
  "id": "share",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "requires": {
    "platform": ["share"]
  },
  "root": {
    "type": "button",
    "label": "Share",
    "onTap": [
      {
        "type": "platform",
        "call": "share.open",
        "args": {
          "files": {
            "value": [
              {
                "asset": "receipt",
                "name": "{data:/filename}",
                "mimeType": "{mime}"
              }
            ]
          }
        }
      }
    ]
  }
}
