{
  "id": "shared",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "state": {
    "open": true
  },
  "root": {
    "type": "column",
    "children": [
      {
        "type": "column",
        "repeat": {
          "items": {
            "path": "/stories"
          },
          "as": "item",
          "key": "id"
        },
        "children": [
          {
            "type": "card",
            "visibleWhen": {
              "key": "open",
              "equals": true
            },
            "shared": {
              "key": "story-{item.id}",
              "as": "bounds"
            },
            "children": [
              {
                "type": "text",
                "text": "{item.id}"
              }
            ]
          }
        ]
      },
      {
        "type": "column",
        "visibleWhen": {
          "key": "open",
          "equals": false
        },
        "shared": {
          "key": "story-one",
          "as": "bounds"
        },
        "children": [
          {
            "type": "text",
            "text": "Story one"
          }
        ]
      }
    ]
  },
  "data": {
    "stories": [
      {
        "id": "one"
      },
      {
        "id": "two"
      }
    ]
  }
}
