{
  "id": "stack-demo",
  "window": {
    "placement": {
      "type": "fullscreen"
    }
  },
  "state": { "open": true },
  "root": {
    "type": "stack",
    "id": "nav",
    "start": "home",
    "style": { "width": { "dp": 320 }, "height": { "dp": 480 } },
    "visibleWhen": { "key": "open", "equals": true },
    "screens": {
      "home": {
        "type": "column",
        "children": [
          {
            "type": "button",
            "label": "push",
            "onTap": [
              {
                "type": "push",
                "stack": "nav",
                "screen": "detail"
              }
            ]
          },
          {
            "type": "button",
            "label": "pop",
            "onTap": [
              {
                "type": "pop",
                "stack": "nav"
              }
            ]
          },
          {
            "type": "button",
            "label": "popToRoot",
            "onTap": [
              {
                "type": "popToRoot",
                "stack": "nav"
              }
            ]
          },
          {
            "type": "button",
            "label": "replace",
            "onTap": [
              {
                "type": "replace",
                "stack": "nav",
                "screen": "detail"
              }
            ]
          }
        ]
      },
      "detail": {
        "type": "text",
        "text": "Screen"
      },
      "third": {
        "type": "text",
        "text": "Third"
      }
    }
  }
}
