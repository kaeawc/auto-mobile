{
  "id": "carousel",
  "window": {
    "placement": {
      "type": "fullscreen"
    },
    "opacity": 100
  },
  "root": {
    "repeat": {
      "items": [
        {
          "title": "A"
        },
        {
          "title": "B"
        }
      ],
      "as": "item"
    },
    "type": "carousel",
    "variant": "hero",
    "itemWidth": 10000,
    "children": [
      {
        "testTag": "slide",
        "type": "card",
        "children": [
          {
            "type": "text",
            "text": "{item.title}"
          }
        ]
      }
    ]
  }
}
