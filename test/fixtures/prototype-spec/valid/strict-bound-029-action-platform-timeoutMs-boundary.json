{
  "id": "platform-call",
  "window": {
    "placement": {
      "type": "fullscreen"
    },
    "opacity": 100
  },
  "data": {
    "echo": {}
  },
  "state": {
    "echoStatus": "idle",
    "sent": false
  },
  "requires": {
    "platform": ["test"]
  },
  "root": {
    "type": "column",
    "children": [
      {
        "id": "go",
        "onTap": [
          {
            "type": "platform",
            "call": "test.echo",
            "args": {
              "message": {
                "state": "echoStatus"
              },
              "delayMs": {
                "value": 10
              }
            },
            "into": "/data/echo",
            "statusKey": "echoStatus",
            "timeoutMs": 300000,
            "onSuccess": [
              {
                "type": "setState",
                "key": "sent",
                "value": true
              }
            ],
            "onError": [
              {
                "type": "emit",
                "name": "echo_failed"
              }
            ]
          }
        ],
        "type": "button",
        "label": "Go"
      }
    ]
  }
}
