{
  "id": "motion-v2",
  "window": {
    "placement": {
      "type": "fullscreen"
    },
    "opacity": 100
  },
  "state": {
    "liked": false,
    "drawer": false
  },
  "root": {
    "type": "column",
    "children": [
      {
        "id": "heart",
        "onTap": [
          {
            "type": "toggle",
            "key": "liked"
          }
        ],
        "style": {
          "scale": 1,
          "color": "onSurface"
        },
        "styleWhen": [
          {
            "when": {
              "key": "liked",
              "equals": true
            },
            "style": {
              "scale": 1.4,
              "rotation": -10,
              "color": "error"
            }
          }
        ],
        "animate": {
          "durationMs": 250,
          "easing": "spring"
        },
        "type": "icon",
        "name": "favorite"
      },
      {
        "id": "drawer",
        "visibleWhen": {
          "key": "drawer",
          "equals": true
        },
        "transition": "slideStart",
        "type": "box",
        "children": [
          {
            "type": "text",
            "text": "Drawer"
          }
        ]
      },
      {
        "visibleWhen": {
          "key": "drawer",
          "equals": true
        },
        "transition": "slideEnd",
        "type": "box",
        "children": [
          {
            "type": "text",
            "text": "Panel"
          }
        ]
      },
      {
        "visibleWhen": {
          "key": "liked",
          "equals": true
        },
        "transition": "scale",
        "type": "box",
        "children": [
          {
            "type": "text",
            "text": "Liked!"
          }
        ]
      },
      {
        "contentDescription": "Photo",
        "type": "image",
        "asset": "photo",
        "contentScale": "fit",
        "zoomable": {
          "maxScale": 8
        }
      },
      {
        "onTap": [
          {
            "type": "toggle",
            "key": "drawer"
          }
        ],
        "style": {
          "alpha": 1
        },
        "styleWhen": [
          {
            "when": {
              "key": "drawer",
              "equals": true
            },
            "style": {
              "offset": {
                "x": 8,
                "y": 0
              },
              "alpha": 0.6
            }
          }
        ],
        "animate": {},
        "type": "button",
        "label": "Menu"
      }
    ]
  }
}
