{
  "description": "Refusals that cross the wire outside an MCP tool result, which the runners' refusal classifier never reads: socket-frame (the control socket failure frame, from mcpRequestFailureDetails), delete-device (deleteDevice's failure result, fields under failure) and managed-slots-result (the ManagedSlotsResult of the MCP initialize outcome and the automobile:managed-slots resource, failure on the slot). Each file is <surface>.<name>.json, regenerated with UPDATE_CAPTURED_FIXTURES=1 bun test test/daemon/refusalWireContract.test.ts. expected uses the vocabulary of ../expectations.json; fields pins the code, retryable, acquireNewSession (nextAction is acquire_new_session), a positive retryAfterMs, and the evidence (details, or capacity for a slot failure). A field absent from a row is absent on the wire.",
  "fixtures": {
    "socket-frame.device_owned_by_other_session": {
      "expected": "wait",
      "fields": {
        "code": "device_owned_by_other_session",
        "retryable": false,
        "acquireNewSession": false,
        "details": {
          "deviceId": "emulator-5554"
        }
      }
    },
    "socket-frame.device_outside_bound_session": {
      "expected": "fail",
      "fields": {
        "code": "device_outside_bound_session",
        "retryable": false,
        "acquireNewSession": false,
        "details": {
          "boundSessionUuid": "11111111-1111-4111-8111-111111111111",
          "boundDeviceId": "emulator-5556",
          "deviceId": "emulator-5554"
        }
      }
    },
    "socket-frame.capacity_exhausted.ios": {
      "expected": "wait",
      "fields": {
        "code": "capacity_exhausted",
        "retryable": true,
        "acquireNewSession": false,
        "retryAfterMs": 5000,
        "details": {
          "platform": "ios",
          "limit": 2,
          "booted": 2,
          "retryAfterMs": 5000,
          "externalDevices": ["9A1B2C3D-0000-4000-8000-000000000001"],
          "code": "capacity_exhausted",
          "retryable": true
        }
      }
    },
    "socket-frame.discovery_incomplete.ios": {
      "expected": "wait",
