{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src",
    "test/**/*.typecheck.ts",
    "scripts/ci/attestation/**/*.ts",
    "scripts/ci/attestation-gate.ts",
    "scripts/ci/produce-attestations.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
