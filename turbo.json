{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "envMode": "strict",
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "description": "Compile TypeScript source to dist/",
      "outputs": ["dist/**"],
      "inputs": [
        "src/**",
        "build.ts",
        "schemas/**",
        "scripts/build-ios-assets.js",
        "package.json"
      ],
      "outputLogs": "new-only",
      "env": [
        "AUTOMOBILE_SOURCEMAP_INCLUDE_DEPS",
        "RELEASE_VERSION",
        "APK_SHA256_CHECKSUM",
        "IOS_CTRL_PROXY_SHA256_CHECKSUM"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS"]
    },
    "lint": {
      "description": "Run ESLint with auto-fix on source and test files",
      "inputs": [
        "src/**",
        "test/**",
        "scripts/**/*.ts",
        "eslint.config.mjs",
        "eslint-suppressions.json",
        "tsconfig.json"
      ],
      "outputs": [],
      "outputLogs": "new-only",
      "passThroughEnv": ["CI", "GITHUB_ACTIONS"]
    },
    "test": {
      "description": "Run Bun test suite",
      "inputs": [
        "src/**",
        "test/**",
        "schemas/**",
        "scripts/**",
        "package.json",
        "bunfig.toml",
        ".github/workflows/**"
      ],
      "outputs": [],
      "outputLogs": "new-only",
      "env": ["AUTOMOBILE_TEST_MODE"],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "DEBUG_ADB_EXEC"]
    },
    "check:android-emulator-boundary": {
      "description": "Prevent Android emulator execution outside AndroidEmulatorClient",
      "inputs": [
        "src/**",
        "scripts/check-android-emulator-boundary.sh",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "check:ios-ctrl-proxy-process-boundary": {
      "description": "Keep CtrlProxy PID tooling behind IOSCtrlProxyProcessClient",
      "inputs": [
        "src/**",
        "scripts/check-ios-ctrl-proxy-process-boundary.ts",
        "scripts/check-ios-ctrl-proxy-process-boundary.sh",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "test:coverage": {
      "description": "Run tests with coverage reporting to coverage/",
      "inputs": [
        "src/**",
        "test/**",
        "schemas/**",
        "scripts/**",
        "package.json",
        "bunfig.toml"
      ],
      "outputs": ["coverage/**"],
      "outputLogs": "new-only",
      "env": ["AUTOMOBILE_TEST_MODE"],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS"]
    }
  }
}
