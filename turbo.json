{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "envMode": "strict",
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "description": "Compile TypeScript source to dist/",
      "outputs": ["dist/**"],
      "inputs": ["src/**", "build.ts", "schemas/**", "package.json"],
      "outputLogs": "new-only",
      "env": [
        "AUTOMOBILE_SOURCEMAP_INCLUDE_DEPS",
        "RELEASE_VERSION",
        "APK_SHA256_CHECKSUM",
        "IOS_CTRL_PROXY_SHA256_CHECKSUM"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS"]
    },
    "lint": {
      "description": "Run oxlint with auto-fix on source and test files, then the oxlint ratchet gate",
      "inputs": [
        "src/**",
        "test/**",
        "scripts/**/*.ts",
        "scripts/oxlint-baseline.sh",
        "scripts/oxlint-baseline.txt",
        ".oxlintrc.json",
        "oxlint-plugins/**",
        "tsconfig.json"
      ],
      "outputs": [],
      "outputLogs": "new-only",
      "passThroughEnv": ["CI", "GITHUB_ACTIONS"]
    },
    "test": {
      "description": "Run the hermetic Bun unit suite. The android/** and ios/** globs below are read off disk by cross-language source-scan guards no TS import can reach (registrationTeardownGuard, ctrlProxyProtocol, webrtcDeviceCaptureLatency, pinchGoldenVectorParity, coordinateMappingGoldenVectorParity); without them a Kotlin/Swift-only diff replays a cached result and the guard never runs. turbo.json is an input so editing test:coverage's list cannot leave this hash stale. Do not narrow or drop these without updating test/lint/turboTestInputsCoverNativeSources.integration.test.ts (issue #4351).",
      "inputs": [
        "src/**",
        "test/**",
        "schemas/**",
        "scripts/**",
        "package.json",
        "bunfig.toml",
        ".github/workflows/**",
        "turbo.json",
        "android/auto-mobile-sdk/src/main/kotlin/**",
        "android/control-proxy/src/main/kotlin/**",
        "android/control-proxy/src/test/kotlin/**",
        "android/desktop-core/src/test/kotlin/**",
        "android/protocol/src/main/kotlin/**",
        "android/video-server/src/main/kotlin/**",
        "ios/auto-mobile-sdk/Sources/**",
        "ios/control-proxy/Sources/**",
        "ios/control-proxy/Tests/**"
      ],
      "outputs": [],
      "outputLogs": "new-only",
      "env": [
        "AUTOMOBILE_TEST_MODE",
        "AUTOMOBILE_UNIT_TEST_WORKERS",
        "AUTOMOBILE_TEST_TIMEOUT_MS",
        "AUTOMOBILE_TEST_WALL_TIMEOUT_SECONDS"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "DEBUG_ADB_EXEC"]
    },
    "test:unit": {
      "description": "Explicit alias of the hermetic Bun unit suite; native inputs mirror test and test:coverage for test/lint/turboTestInputsCoverNativeSources.integration.test.ts.",
      "inputs": [
        "src/**",
        "test/**",
        "schemas/**",
        "scripts/**",
        "package.json",
        "bunfig.toml",
        ".github/workflows/**",
        "turbo.json",
        "android/auto-mobile-sdk/src/main/kotlin/**",
        "android/control-proxy/src/main/kotlin/**",
        "android/control-proxy/src/test/kotlin/**",
        "android/desktop-core/src/test/kotlin/**",
        "android/protocol/src/main/kotlin/**",
        "android/video-server/src/main/kotlin/**",
        "ios/auto-mobile-sdk/Sources/**",
        "ios/control-proxy/Sources/**",
        "ios/control-proxy/Tests/**"
      ],
      "outputs": [],
      "outputLogs": "new-only",
      "env": [
        "AUTOMOBILE_TEST_MODE",
        "AUTOMOBILE_UNIT_TEST_WORKERS",
        "AUTOMOBILE_TEST_TIMEOUT_MS",
        "AUTOMOBILE_TEST_WALL_TIMEOUT_SECONDS"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "DEBUG_ADB_EXEC"]
    },
    "test:changed": {
      "description": "Run Bun unit tests affected by local or base-ref changes; never cache git-worktree-sensitive selection.",
      "inputs": ["src/**", "test/**", "scripts/test-ts.sh", "package.json", "bunfig.toml"],
      "outputs": [],
      "outputLogs": "new-only",
      "cache": false,
      "env": [
        "AUTOMOBILE_TEST_MODE",
        "AUTOMOBILE_UNIT_TEST_BASE_REF",
        "AUTOMOBILE_UNIT_TEST_WORKERS",
        "AUTOMOBILE_TEST_TIMEOUT_MS",
        "AUTOMOBILE_TEST_WALL_TIMEOUT_SECONDS"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "DEBUG_ADB_EXEC"]
    },
    "test:integration": {
      "description": "Run host real-I/O and repository-contract tests selected by the *.integration.test.ts contract. Integration tests read shell scripts, workflow definitions, and native source trees directly, so those inputs and turbo.json must invalidate cached results. Keep the native inputs in sync with test/lint/turboTestInputsCoverNativeSources.integration.test.ts (issue #4351).",
      "inputs": [
        "src/**",
        "test/**",
        "scripts/**",
        "package.json",
        "bunfig.toml",
        ".github/workflows/**",
        "turbo.json",
        "android/auto-mobile-sdk/src/main/kotlin/**",
        "android/control-proxy/src/main/kotlin/**",
        "android/control-proxy/src/test/kotlin/**",
        "android/desktop-core/**",
        "android/desktop-core/src/test/kotlin/**",
        "android/protocol/src/main/kotlin/**",
        "android/video-server/src/main/kotlin/**",
        "ios/auto-mobile-sdk/Sources/**",
        "ios/control-proxy/Sources/**",
        "ios/control-proxy/Tests/**"
      ],
      "outputs": [],
      "outputLogs": "new-only",
      "env": [
        "AUTOMOBILE_TEST_MODE",
        "AUTOMOBILE_INTEGRATION_TEST_WORKERS",
        "AUTOMOBILE_TEST_TIMEOUT_MS",
        "AUTOMOBILE_TEST_WALL_TIMEOUT_SECONDS"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "DEBUG_ADB_EXEC"]
    },
    "test:stress": {
      "description": "Run explicit stress tests separately from unit and integration feedback.",
      "inputs": ["src/**", "test/stress/**", "scripts/test-ts.sh", "package.json", "bunfig.toml"],
      "outputs": [],
      "outputLogs": "new-only",
      "cache": false,
      "env": [
        "AUTOMOBILE_TEST_MODE",
        "AUTOMOBILE_TEST_TIMEOUT_MS",
        "AUTOMOBILE_TEST_WALL_TIMEOUT_SECONDS"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "DEBUG_ADB_EXEC"]
    },
    "test:all": {
      "description": "Run unit, host integration, and stress lanes in sequence.",
      "inputs": ["src/**", "test/**", "scripts/**", "package.json", "bunfig.toml", "turbo.json"],
      "outputs": [],
      "outputLogs": "new-only",
      "cache": false,
      "env": [
        "AUTOMOBILE_TEST_MODE",
        "AUTOMOBILE_UNIT_TEST_WORKERS",
        "AUTOMOBILE_INTEGRATION_TEST_WORKERS",
        "AUTOMOBILE_TEST_TIMEOUT_MS",
        "AUTOMOBILE_TEST_WALL_TIMEOUT_SECONDS"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS", "DEBUG_ADB_EXEC"]
    },
    "check:android-emulator-boundary": {
      "description": "Prevent Android emulator execution outside AndroidEmulatorClient",
      "inputs": ["src/**", "scripts/check-android-emulator-boundary.sh", "package.json"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "check:ios-ctrl-proxy-process-boundary": {
      "description": "Keep CtrlProxy PID tooling behind IOSCtrlProxyProcessClient",
      "inputs": [
        "src/**",
        "scripts/check-ios-ctrl-proxy-process-boundary.ts",
        "scripts/check-ios-ctrl-proxy-process-boundary.sh",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "check:host-shell-boundary": {
      "description": "Prevent new production host-shell execution",
      "inputs": ["src/**", "scripts/check-host-shell-boundary.ts", "package.json"],
      "outputs": [],
      "outputLogs": "new-only",
      "cache": false
    },
    "typecheck": {
      "description": "tsgo --noEmit baseline gate (scripts/typecheck-baseline.sh, issue #3001). Cached on src/** + tsconfig + the baseline so an unchanged src/ skips the ~5.6s run; a test/docs/native-only edit is a cache hit. Keyed on declared inputs, not the tsc/tsgo binary, so it is migration-neutral — a TypeScript-version bump changes package.json and the regenerated baseline and busts the hash. Only exit-0 is cached, so a red gate is never memoized.",
      "inputs": [
        "src/**",
        "tsconfig.json",
        "scripts/typecheck-baseline.sh",
        "scripts/typecheck-baseline.txt",
        "package.json"
      ],
      "outputs": [],
      "outputLogs": "new-only",
      "passThroughEnv": ["CI", "GITHUB_ACTIONS"]
    },
    "test:coverage": {
      "description": "Run the hermetic unit lane with coverage reporting to coverage/. The android/** and ios/** globs below are read off disk by cross-language source-scan guards no TS import can reach; without them a Kotlin/Swift-only diff replays a cached result and the guard never runs. turbo.json is an input so editing test's list cannot leave this hash stale. Do not narrow or drop these without updating test/lint/turboTestInputsCoverNativeSources.integration.test.ts (issue #4351).",
      "inputs": [
        "src/**",
        "test/**",
        "schemas/**",
        "scripts/**",
        "package.json",
        "bunfig.toml",
        "turbo.json",
        "android/auto-mobile-sdk/src/main/kotlin/**",
        "android/control-proxy/src/main/kotlin/**",
        "android/control-proxy/src/test/kotlin/**",
        "android/desktop-core/src/test/kotlin/**",
        "android/protocol/src/main/kotlin/**",
        "android/video-server/src/main/kotlin/**",
        "ios/auto-mobile-sdk/Sources/**",
        "ios/control-proxy/Sources/**",
        "ios/control-proxy/Tests/**"
      ],
      "outputs": ["coverage/**"],
      "outputLogs": "new-only",
      "env": [
        "AUTOMOBILE_TEST_MODE",
        "AUTOMOBILE_UNIT_TEST_WORKERS",
        "AUTOMOBILE_TEST_TIMEOUT_MS",
        "AUTOMOBILE_TEST_WALL_TIMEOUT_SECONDS"
      ],
      "passThroughEnv": ["CI", "GITHUB_ACTIONS"]
    }
  }
}
